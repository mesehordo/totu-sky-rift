msgctxt "unit.imp_szellemkolosszus.desc"
msgid "Egy elesett óriás lelke."
msgstr "The soul of a fallen giant."

msgctxt "unit.imp_hos_livia.name"
msgid "Livia Varr"
msgstr "Livia Varr"

msgctxt "unit.imp_hos_livia.desc"
msgid "Egykori orvos, a lélekhorgonyokat mentő légió tisztje."
msgstr "Once a physician, now an officer of the legion that rescues soul anchors."

msgctxt "unit.imp_hos_nera.name"
msgid "Nera"
msgstr "Nera"

msgctxt "unit.imp_hos_nera.desc"
msgid "Livia lánya: gyermekként került géptestbe; hetven év tapasztalattal, de a birodalmi jog szerint még mindig kiskorú."
msgstr "Livia's daughter: put into a machine body as a child; seventy years of experience, but by imperial law still a minor."

msgctxt "unit.imp_onager.name"
msgid "Onager-mecha"
msgstr "Onager Mech"

msgctxt "unit.imp_onager.desc"
msgid "Négylábú hajítógép: messzire hord, épületek és csoportok ellen. Felállítás: lövés előtt 2 mp-ig áll fel (utána +1 lőtáv), mozgás előtt 1 mp-ig csukódik össze."
msgstr "Four-legged throwing engine: long range, against buildings and groups."

msgctxt "unit.imp_hos_cassius.name"
msgid "Cassius Ferrum legátus"
msgstr "Legate Cassius Ferrum"

msgctxt "unit.imp_hos_cassius.desc"
msgid "A Hetedik Légió parancsnoka nehéz géptestben: roham, fegyelem és Ordan haragja."
msgstr "Commander of the Seventh Legion in a heavy machine body: charge, discipline and the wrath of Ordan."

msgctxt "unit.imp_lelekhorgony.name"
msgid "Lélekhorgony"
msgstr "Soul Anchor"

msgctxt "unit.imp_lelekhorgony.desc"
msgid "Egy elesett gép lelke. Egy Fabrikátor 40 mp-en belül újraépítheti (javítással) – különben a lélek elillan."
msgstr "The soul of a fallen machine. A Fabricator can rebuild it within 40 s (by repairing) – otherwise the soul fades."

msgctxt "unit.imp_praetorianus.name"
msgid "Praetoriánus"
msgstr "Praetorian"

msgctxt "unit.imp_praetorianus.desc"
msgid "Elit gépharcos aranyozott páncélban: a légió gerince."
msgstr "An elite machine warrior in gilded armour: the backbone of the legion."

msgctxt "unit.imp_arato.name"
msgid "Arató"
msgstr ""

msgctxt "unit.imp_arato.desc"
msgid "Lánctalpas gyűjtőgép: aranyat és meteoritot bányászik, egyszerre nagy rakománnyal (30 arany vagy 20 meteorit). Lassú és drága – egy kilőtt Arató egy teljes rakomány."
msgstr ""

msgctxt "building.imp_forum.name"
msgid "Fórum"
msgstr "Forum"

msgctxt "building.imp_forum.desc"
msgid "Oszlopcsarnokos főtér gőzölgő gépházzal. Leadóhely, Fabrikátorokat gyárt."
msgstr "Colonnaded square with a steaming engine house. Drop-off, builds Fabricators."

msgctxt "building.imp_reaktor.name"
msgid "Lélekreaktor"
msgstr "Soul Reactor"

msgctxt "building.imp_reaktor.desc"
msgid "+10 létszám – lélekenergiát ad a gépeknek."
msgstr "+10 population – gives soul energy to the machines."

msgctxt "building.imp_legiogyar.name"
msgid "Légió-gyár"
msgstr "Legion Works"

msgctxt "building.imp_legiogyar.desc"
msgid "Légiósokat és Ballistariusokat szerel össze."
msgstr "Assembles Legionaries and Ballistarii."

msgctxt "building.imp_ontode.name"
msgid "Öntöde"
msgstr "Foundry"

msgctxt "building.imp_ontode.desc"
msgid "Centurio-mechákat és Kolosszusokat önt."
msgstr "Casts Centurion Mechs, Onagers and Colossi."

msgctxt "building.imp_gepisten_templom.name"
msgid "Ordan temploma"
msgstr "Temple of Ordan"

msgctxt "building.imp_gepisten_templom.desc"
msgid "Ordan, a Kéz, amely Megtart hálózatának szentélye. Szellemidézőket avat, fejlesztéseket kutat."
msgstr "Shrine of the network of Ordan, the Hand that Holds. Ordains Soul Callers, researches upgrades."

msgctxt "building.imp_hangar.name"
msgid "Hangár"
msgstr "Hangar"

msgctxt "building.imp_hangar.desc"
msgid "Aquila-drónokat gyárt."
msgstr "Builds Aquila Drones."

msgctxt "building.imp_aquila_torony.name"
msgid "Aquila-torony"
msgstr "Aquila Tower"

msgctxt "building.imp_aquila_torony.desc"
msgid "Sasos őrtorony íjpuskával."
msgstr "Eagle watchtower with a crossbow."

msgctxt "building.imp_panteon.name"
msgid "Panteon"
msgstr "Pantheon"

msgctxt "building.imp_panteon.desc"
msgid "A megmentett hősök csarnoka: Livia, Nera és Cassius."
msgstr "The hall of the rescued heroes: Livia, Nera and Cassius."

msgctxt "building.imp_praetorium.name"
msgid "Praetorium"
msgstr "Praetorium"

msgctxt "building.imp_praetorium.desc"
msgid "A légió parancsnoksága: praetoriánusok és Centurio-mechák."
msgstr "The legion's headquarters: praetorians and Centurio mechs."

msgctxt "building.imp_lelekkut.name"
msgid "Lélekkút"
msgstr "Soul Well"

msgctxt "building.imp_lelekkut.desc"
msgid "Lélekfénnyel izzó kút: állandó szellemlégiósok és szellemkolosszusok."
msgstr "A well glowing with soul-light: permanent spirit legionaries and spirit colossi."

msgctxt "building.imp_diplomacia.name"
msgid "Diplomácia csarnoka"
msgstr ""

msgctxt "building.imp_diplomacia.desc"
msgid "Itt köthetsz szövetséget egy kisebb néppel (egyszer, véglegesen). A szövetség után a nép épületei a munkásaid építési listáján jelennek meg."
msgstr ""

msgctxt "building.imp_alapozas.name"
msgid "Alapozás"
msgstr ""

msgctxt "building.imp_alapozas.desc"
msgid "Márvány-lapkő (2×2): a Fabrikátor 3 mp alatt rakja le, a mozgást nem akadályozza. Ami teljes egészében alapozáson áll, teljes életerővel épül fel; ami nem, az fél életerővel, és lassan kopik is (fél életerőig)."
msgstr ""

msgctxt "building.imp_finomito.name"
msgid "Finomító"
msgstr ""

msgctxt "building.imp_finomito.desc"
msgid "Lerakóhely aranyhoz és meteorithoz – érdemes a bányák mellé építeni. Itt választható az Arató fejlesztése: gyorsabb hajtómű VAGY nagyobb tartály."
msgstr ""

msgctxt "building.imp_szobor_ferrox.name"
msgid "Ferrox-szobor"
msgstr ""

msgctxt "building.imp_szobor_ferrox.desc"
msgid "Ferrox, az acél ura: kalapácsos, öntöttvas-szakállú alak. A körzetében (6 csempe) a gépek és az épületek +2 páncélt kapnak – amíg a szobor áll."
msgstr ""

msgctxt "building.imp_szobor_arcanor.name"
msgid "Arcanor-szobor"
msgstr ""

msgctxt "building.imp_szobor_arcanor.desc"
msgid "Arcanor, a mágia ura: csillagköpenyes alak, lebegő gömbbel. A körzetében (6 csempe) a távolsági egységek +1 lőtávot kapnak – amíg a szobor áll."
msgstr ""

msgctxt "building.imp_szobor_umbrax.name"
msgid "Umbrax-szobor"
msgstr ""

msgctxt "building.imp_szobor_umbrax.desc"
msgid "Umbrax, a túlvilág kapusa: fátylas alak lámpással és kulccsal. A körzetében (6 csempe) az egységek +1 életerőt töltenek vissza másodpercenként – amíg a szobor áll."
msgstr ""

msgctxt "building.imp_szoborpark.name"
msgid "Szoborpark"
msgstr ""

msgctxt "building.imp_szoborpark.desc"
msgid "Az öreg istenek – Ferrox, Arcanor és Umbrax – szoborparkja. Itt kutathatók az isteni fejlesztések, aranyért; mindegyik csak akkor, ha az adott isten szobra áll."
msgstr ""

msgctxt "building.imp_egko.name"
msgid "Égkő"
msgstr ""

msgctxt "building.imp_egko.desc"
msgid "Lerakott meteoritszilánk: Égkő-fényt áraszt (5 csempe), mint egy meteorit – a mágiahasználók erősebbek, a meteoritrokon népek gyógyulnak. MINDENKINEK hat, és bárki lerombolhatja."
msgstr ""

msgctxt "building.imp_nagy_alapozas.name"
msgid "Nagy alapozás"
msgstr ""

msgctxt "building.imp_nagy_alapozas.desc"
msgid "Márvány-lapkő (4×4): csempénként olcsóbb, a Fabrikátor 6 mp alatt rakja le. (A Nagy alapozás kutatás kell hozzá az Öntödében.)"
msgstr ""

msgctxt "research.imp_lelekhorgony_mentes.name"
msgid "Lélekhorgony mentése"
msgstr ""

msgctxt "research.imp_lelekhorgony_mentes.desc"
msgid "A Légiósok egyenként felvehetnek és áthelyezhetnek egy saját Lélekhorgonyt."
msgstr ""

msgctxt "research.imp_legiopengek.name"
msgid "Légiós pengék"
msgstr "Legion Blades"

msgctxt "research.imp_legiopengek.desc"
msgid "+2 sebzés a közelharci egységeknek."
msgstr "+2 damage for melee units."

msgctxt "research.imp_gyorstoltes.name"
msgid "Gyorstöltés"
msgstr "Quick Loading"

msgctxt "research.imp_gyorstoltes.desc"
msgid "+2 sebzés a távolsági egységeknek."
msgstr "+2 damage for ranged units."

msgctxt "research.imp_edzett_acel.name"
msgid "Edzett acél"
msgstr "Tempered Steel"

msgctxt "research.imp_edzett_acel.desc"
msgid "+1 páncél minden gépnek."
msgstr "+1 armour for every machine."

msgctxt "research.imp_megerositett_vaz.name"
msgid "Megerősített váz"
msgstr "Reinforced Frame"

msgctxt "research.imp_megerositett_vaz.desc"
msgid "+30 életerő minden gépnek."
msgstr "+30 health for every machine."

msgctxt "research.imp_hajtomu.name"
msgid "Gyorsított hajtómű"
msgstr ""

msgctxt "research.imp_hajtomu.desc"
msgid "+25% sebesség az Aratóknak. (Kizárja a Bővített tartályt.)"
msgstr ""

msgctxt "research.imp_tartaly.name"
msgid "Bővített tartály"
msgstr ""

msgctxt "research.imp_tartaly.desc"
msgid "+50% rakomány az Aratóknak. (Kizárja a Gyorsított hajtóművet.)"
msgstr ""

msgctxt "research.imp_ferrox_kalapacsa.name"
msgid "Ferrox kalapácsa"
msgstr ""

msgctxt "research.imp_ferrox_kalapacsa.desc"
msgid "+2 sebzés a közelharcos egységeknek. (Kell hozzá: Ferrox-szobor.)"
msgstr ""

msgctxt "research.imp_ontottvas_burok.name"
msgid "Öntöttvas burok"
msgstr ""

msgctxt "research.imp_ontottvas_burok.desc"
msgid "+60 életerő a nagy gépeknek. (Kell hozzá: Ferrox-szobor.)"
msgstr ""

msgctxt "research.imp_arcanor_csillagai.name"
msgid "Arcanor csillagai"
msgstr ""

msgctxt "research.imp_arcanor_csillagai.desc"
msgid "+25 energia a varázslóknak. (Kell hozzá: Arcanor-szobor.)"
msgstr ""

msgctxt "research.imp_csillagterkep.name"
msgid "Csillagtérkép"
msgstr ""

msgctxt "research.imp_csillagterkep.desc"
msgid "+2 látótáv minden egységnek. (Kell hozzá: Arcanor-szobor.)"
msgstr ""

msgctxt "research.imp_umbrax_fatyla.name"
msgid "Umbrax fátyla"
msgstr ""

msgctxt "research.imp_umbrax_fatyla.desc"
msgid "+15% sebesség a szellem-egységeknek. (Kell hozzá: Umbrax-szobor.)"
msgstr ""

msgctxt "research.imp_lelekkapu.name"
msgid "Lélekkapu"
msgstr ""

msgctxt "research.imp_lelekkapu.desc"
msgid "Az elesett ellenségek 8% eséllyel szellemlégiósként kelnek fel a te oldaladon (30 mp-re). (Kell hozzá: Umbrax-szobor.)"
msgstr ""

msgctxt "research.imp_reaktorpajzs.name"
msgid "Reaktorpajzs"
msgstr ""

msgctxt "research.imp_reaktorpajzs.desc"
msgid "A gépek 30 pajzsot kapnak; a pajzs csak Lélekreaktor (6 csempe), meteorit vagy Égkő közelében töltődik."
msgstr ""

msgctxt "research.imp_nagy_alapozas.name"
msgid "Nagy alapozás"
msgstr ""

msgctxt "research.imp_nagy_alapozas.desc"
msgid "A Fabrikátorok 4×4-es márvány-lapkövet is lerakhatnak (30 arany, 6 mp): csempénként olcsóbb. A meglévő lapkövek nem változnak."
msgstr ""

msgctxt "research.imp_legiopengek_2.name"
msgid "Légiós pengék II."
msgstr ""

msgctxt "research.imp_legiopengek_2.desc"
msgid "+2 sebzés a közelharci egységeknek. (II. szint)"
msgstr ""

msgctxt "research.imp_legiopengek_3.name"
msgid "Légiós pengék III."
msgstr ""

msgctxt "research.imp_legiopengek_3.desc"
msgid "+2 sebzés a közelharci egységeknek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.imp_gyorstoltes_2.name"
msgid "Gyorstöltés II."
msgstr ""

msgctxt "research.imp_gyorstoltes_2.desc"
msgid "+2 sebzés a távolsági egységeknek. (II. szint)"
msgstr ""

msgctxt "research.imp_gyorstoltes_3.name"
msgid "Gyorstöltés III."
msgstr ""

msgctxt "research.imp_gyorstoltes_3.desc"
msgid "+2 sebzés a távolsági egységeknek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.imp_edzett_acel_2.name"
msgid "Edzett acél II."
msgstr ""

msgctxt "research.imp_edzett_acel_2.desc"
msgid "+1 páncél minden gépnek. (II. szint)"
msgstr ""

msgctxt "research.imp_edzett_acel_3.name"
msgid "Edzett acél III."
msgstr ""

msgctxt "research.imp_edzett_acel_3.desc"
msgid "+1 páncél minden gépnek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.imp_ferrox_kalapacsa_2.name"
msgid "Ferrox kalapácsa II."
msgstr ""

msgctxt "research.imp_ferrox_kalapacsa_2.desc"
msgid "+2 sebzés a közelharcos egységeknek. (Kell hozzá: Ferrox-szobor.) (II. szint)"
msgstr ""

msgctxt "research.imp_ferrox_kalapacsa_3.name"
msgid "Ferrox kalapácsa III."
msgstr ""

msgctxt "research.imp_ferrox_kalapacsa_3.desc"
msgid "+2 sebzés a közelharcos egységeknek. (Kell hozzá: Ferrox-szobor.) (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.imp_goztulnyomas.name"
msgid "Gőztúlnyomás"
msgstr ""

msgctxt "research.imp_goztulnyomas.desc"
msgid "A gépek megkapják a Gőztúlnyomás képességet: 6 mp-re +40% sebesség, utána 3 mp-ig lassabbak."
msgstr ""

msgctxt "research.imp_szikrafogo.name"
msgid "Szikrafogó vértek"
msgstr ""

msgctxt "research.imp_szikrafogo.desc"
msgid "A gépek nem gyengék a varázslók ellen."
msgstr ""

msgctxt "faction.imperium.name"
msgid "Aurethi Birodalom"
msgstr "Iron Empire"

msgctxt "faction.imperium.desc"
msgid "Aureth népe: az Égszakadás éterbetegségében haldokló embereket Ordan, a Kéz, amely Megtart, géptestekbe vezette át. Valódi emberi szellemek acélban – nem születnek új tagjaik, ezért minden nyersanyag számukra életfeltétel. Létszámukat a lélekreaktorok adják; a Fabrikátorok javítják a gépeket, a szellemidézők az elesettekből légiót támasztanak."
msgstr "The people of Aureth: Ordan, the Hand that Holds, carried those dying of the ether sickness of the Skyfall into machine bodies. Real human souls in steel – no new members are born to them, so every resource is a matter of life. Their numbers come from soul reactors; Fabricators repair the machines, and soul callers raise a legion from the fallen."

msgctxt "faction.imperium.tagline"
msgid "Lélekidézés • gépjavítás • ostrom • lélekreaktorok"
msgstr "Soul calling • machine repair • siege • soul reactors"

msgctxt "path.imperium.legio.name"
msgid "Légió"
msgstr "Legion"

msgctxt "path.imperium.legio.desc"
msgid "Alakzat: a gyalogosok minden közeli bajtársért +6% sebzést kapnak (max. +30%), és +1 páncélt. Praetoriánusok és Centurio-mechák."
msgstr "Formation: infantry gain +6% damage for every nearby comrade (max. +30%) and +1 armour. Praetorians and Centurio mechs."

msgctxt "path.imperium.legio.tagline"
msgid "Fegyelmezett tömeg alakzatban"
msgstr "A disciplined mass in formation"

msgctxt "path.imperium.gepisten.name"
msgid "Gépisten"
msgstr "Machine God"

msgctxt "path.imperium.gepisten.desc"
msgid "Kolosszusok és onager-mechák, +150 életerővel és +4 ostromsebzéssel. Lassú, drága, de megállíthatatlan."
msgstr "Colossi and onager mechs with +150 health and +4 siege damage. Slow, costly, but unstoppable."

msgctxt "path.imperium.gepisten.tagline"
msgid "Kevés, hatalmas gép"
msgstr "Few, enormous machines"

msgctxt "path.imperium.lelek.name"
msgid "Lélek"
msgstr "Soul"

msgctxt "path.imperium.lelek.desc"
msgid "A megölt élő ellenségek 20%-a szellemlégiósként kel fel nálad (40 mp-re). A Lélekkútban állandó szellemlégiósok és szellemkolosszusok képezhetők."
msgstr "20% of the living enemies you kill rise as spirit legionaries on your side (for 40 s). Permanent spirit legionaries and spirit colossi can be trained at the Soul Well."

msgctxt "path.imperium.lelek.tagline"
msgid "Kifárasztó, élőhalott játék"
msgstr "An attritional, undead game"

msgctxt "unit.myc_sporaszedo.name"
msgid "Spóraszedő"
msgstr "Spore Gatherer"

msgctxt "unit.myc_sporaszedo.desc"
msgid "Munkás. Bármelyik hálózatba kötött épületbe leadhatja a terhét."
msgstr "Worker. Can drop its load at any building linked to the network."

msgctxt "unit.myc_pofeteg.name"
msgid "Pöfeteg"
msgstr "Puffball"

msgctxt "unit.myc_pofeteg.desc"
msgid "Olcsó, ugráló gombalény. Halálakor mérgező spórafelhő tör ki belőle. Hármasával Óriáspöfeteggé olvad."
msgstr "Cheap, hopping fungus creature. A poison spore cloud bursts out when it dies. Three merge into a Giant Puffball."

msgctxt "unit.myc_tuskegomba_lovesz.name"
msgid "Tüskegomba-lövész"
msgstr "Spinecap Shooter"

msgctxt "unit.myc_tuskegomba_lovesz.desc"
msgid "Mérgező spóratüskéket lő, földi és légi célpontokra."
msgstr "Fires poisonous spore spines at ground and air targets."

msgctxt "unit.myc_kalapos_or.name"
msgid "Kalapos őr"
msgstr "Capped Guard"

msgctxt "unit.myc_kalapos_or.desc"
msgid "Vastag kalapú, páncélos gombaharcos."
msgstr "An armoured fungus warrior with a thick cap."

msgctxt "unit.myc_alomsaman.name"
msgid "Álomgomba-sámán"
msgstr "Dreamcap Shaman"

msgctxt "unit.myc_alomsaman.desc"
msgid "Gyökérkötéssel egy területen megbénítja az ellenséget."
msgstr "Binds an area with roots and paralyses the enemy."

msgctxt "unit.myc_oriaspofeteg.name"
msgid "Óriáspöfeteg"
msgstr "Giant Puffball"

msgctxt "unit.myc_oriaspofeteg.desc"
msgid "Három Pöfetegből összeolvadt óriás. Halálakor hatalmas spórarobbanás."
msgstr "A giant merged from three Puffballs. A huge spore blast when it dies."

msgctxt "unit.myc_lebego_pofeteg.name"
msgid "Lebegő pöfeteg"
msgstr "Floating Puffball"

msgctxt "unit.myc_lebego_pofeteg.desc"
msgid "Gázzal telt, lebegő gombatest; spóraesőt szór."
msgstr "A gas-filled floating fungus body; scatters spore rain."

msgctxt "unit.myc_hos_mor.name"
msgid "Mór"
msgstr "Mór"

msgctxt "unit.myc_hos_mor.desc"
msgid "Fiatal emlékkertész, magában hordja egy sérült emlékkert töredékeit. Gyógyít és fertőzést vizsgál."
msgstr "A young memory-gardener carrying fragments of a damaged memory garden inside him. Heals and studies infection."

msgctxt "unit.myc_rothaszto.name"
msgid "Rothasztó"
msgstr "Rotter"

msgctxt "unit.myc_rothaszto.desc"
msgid "Bomló gombatest: közelharcban rothaszt, halálakor mérgező spórafelhőt ereget."
msgstr "A decaying fungus body: rots its foes in melee and releases a poison spore cloud when it dies."

msgctxt "unit.myc_hos_gyokeranya.name"
msgid "A Gyökéranya"
msgstr "The Root Mother"

msgctxt "unit.myc_hos_gyokeranya.desc"
msgid "Az ősi micélium teste: gyökeret ereszt, gúzsba köt, és megrengeti a földet."
msgstr "Body of the ancient mycelium: puts down roots, binds, and shakes the earth."

msgctxt "unit.myc_hos_sporin.name"
msgid "Sporin, a Bomlasztó"
msgstr "Sporin the Decayer"

msgctxt "unit.myc_hos_sporin.desc"
msgid "A bomlás vándora: tüskéi rothasztanak, köpenye spórafelhő."
msgstr "Wanderer of decay: its spines rot, its cloak is a spore cloud."

msgctxt "unit.myc_tetemgomba.name"
msgid "Tetemgomba"
msgstr "Corpse Fungus"

msgctxt "unit.myc_tetemgomba.desc"
msgid "Az elesettekből kelt, gombával átszőtt test: lassú, de nem adja fel."
msgstr "A body risen from the fallen, woven through with fungus: slow, but it never gives up."

msgctxt "unit.myc_fagomba_orias.name"
msgid "Fagomba-óriás"
msgstr "Bracket-fungus Giant"

msgctxt "unit.myc_fagomba_orias.desc"
msgid "Járó, ősi fagomba: a liget védelmezője, gyökereivel megköt."
msgstr "A walking ancient tree fungus: guardian of the grove, binds with its roots."

msgctxt "unit.myc_alomszovo.name"
msgid "Álomszövő"
msgstr "Dreamweaver"

msgctxt "unit.myc_alomszovo.desc"
msgid "Altató spórákat szövő gomba-mágus."
msgstr "A fungal mage weaving sleeping spores."

msgctxt "building.myc_szivgomba.name"
msgid "Szívgomba"
msgstr "Heart Fungus"

msgctxt "building.myc_szivgomba.desc"
msgid "A hálózat szíve: kicsi főépület és védőtorony egyben. +6 létszám (és a hálózat minden összekötött épülete +1), Spóraszedőket nevel, spórákkal lő. Akárhány építhető."
msgstr "Heart of the network: a small main building and defensive tower in one. +6 population (and +1 for every linked building of the network), raises Spore Gatherers, shoots spores. Any number can be built."

msgctxt "building.myc_sporafonal.name"
msgid "Spórafonal"
msgstr "Spore Thread"

msgctxt "building.myc_sporafonal.desc"
msgid "Hálózati csomópont: összeköti az épületeket a Szívgombával."
msgstr "Network node: links buildings to the Heart Fungus."

msgctxt "building.myc_termotest.name"
msgid "Termőtest"
msgstr "Fruiting Body"

msgctxt "building.myc_termotest.desc"
msgid "Pöfetegeket és Kalapos őröket növeszt."
msgstr "Grows Puffballs, Rotters and Capped Guards."

msgctxt "building.myc_tuskegomba_telep.name"
msgid "Tüskegomba-telep"
msgstr "Spinecap Colony"

msgctxt "building.myc_tuskegomba_telep.desc"
msgid "Tüskegomba-lövészeket növeszt."
msgstr "Grows Spinecap Shooters."

msgctxt "building.myc_gyokerbarlang.name"
msgid "Gyökérbarlang"
msgstr "Root Cave"

msgctxt "building.myc_gyokerbarlang.desc"
msgid "Fejlesztések a hálózat mélyén."
msgstr "Upgrades deep within the network."

msgctxt "building.myc_alomkert.name"
msgid "Álomkert"
msgstr "Dream Garden"

msgctxt "building.myc_alomkert.desc"
msgid "Álomgomba-sámánokat nevel."
msgstr "Raises Dreamcap Shamans."

msgctxt "building.myc_lebegobolcso.name"
msgid "Lebegőbölcső"
msgstr "Floating Cradle"

msgctxt "building.myc_lebegobolcso.desc"
msgid "Lebegő pöfetegeket nevel."
msgstr "Raises Floating Puffballs."

msgctxt "building.myc_emlekfa.name"
msgid "Emlékfa"
msgstr "Memory Tree"

msgctxt "building.myc_emlekfa.desc"
msgid "Az elfeledett nevek fája: Mór, a Gyökéranya és Sporin hívása."
msgstr "The tree of forgotten names: calls Mór, the Root Mother and Sporin."

msgctxt "building.myc_rothadokert.name"
msgid "Rothadókert"
msgstr "Rot Garden"

msgctxt "building.myc_rothadokert.desc"
msgid "Bomló tetemeken nőtt gombakert: rothasztók és tetemgombák."
msgstr "A fungus garden grown on decaying corpses: rotters and corpse fungi."

msgctxt "building.myc_oriasliget.name"
msgid "Óriásliget"
msgstr "Giant Grove"

msgctxt "building.myc_oriasliget.desc"
msgid "Ősi fagombák ligete: fagomba-óriások."
msgstr "A grove of ancient tree fungi: bracket-fungus giants."

msgctxt "research.myc_meregspora.name"
msgid "Méregspóra"
msgstr "Poison Spore"

msgctxt "research.myc_meregspora.desc"
msgid "+2 sebzés a távolsági egységeknek."
msgstr "+2 damage for ranged units."

msgctxt "research.myc_kemenykalap.name"
msgid "Keménykalap"
msgstr "Hard Cap"

msgctxt "research.myc_kemenykalap.desc"
msgid "+1 páncél minden egységnek."
msgstr "+1 armour for every unit."

msgctxt "research.myc_gyors_micelium.name"
msgid "Gyors micélium"
msgstr "Swift Mycelium"

msgctxt "research.myc_gyors_micelium.desc"
msgid "+15% sebesség minden egységnek."
msgstr "+15% speed for every unit."

msgctxt "research.myc_dus_spora.name"
msgid "Dús spóra"
msgstr "Rich Spore"

msgctxt "research.myc_dus_spora.desc"
msgid "+20 életerő minden gombaegységnek."
msgstr "+20 health for every fungus unit."

msgctxt "faction.mycel.name"
msgid "Micéliák"
msgstr "Mycelians"

msgctxt "faction.mycel.desc"
msgid "A Mélykertek népe: önálló gombaszemélyek, akiket a föld alatti fonalhálózat köt össze (a fajnév munkacím). Épületeik csak spórafonalakkal a Szívgombához kötve működnek, de bármelyikbe leadható a nyersanyag; három Pöfeteg Óriáspöfeteggé olvad."
msgstr "The people of the Deep Gardens: individual fungal persons bound together by an underground web of threads (the name is a working title). Their buildings only work when linked to a Heart Fungus by spore threads, but resources can be dropped at any of them; three Puffballs merge into a Giant Puffball."

msgctxt "faction.mycel.tagline"
msgid "Spórafonal-hálózat • szívgombák • összeolvadás"
msgstr "Spore-thread network • heart fungi • merging"

msgctxt "path.mycel.rothadas.name"
msgid "Rothadás"
msgstr "Rot"

msgctxt "path.mycel.rothadas.desc"
msgid "A közelharcosaid mérgeznek, és az elesett élőkből 25% eséllyel tetemgomba-zombi kel. Rothasztók vezetik a lassan terjedő pusztulást."
msgstr "Your melee fighters poison, and 25% of fallen living foes rise as corpse-fungus zombies. Rotters lead the slowly spreading decay."

msgctxt "path.mycel.rothadas.tagline"
msgid "Felőrlő, méreggel nyújtott harc"
msgstr "Grinding, poison-prolonged battle"

msgctxt "path.mycel.liget.name"
msgid "Óriásliget"
msgstr "Giant Grove"

msgctxt "path.mycel.liget.desc"
msgid "A hálózat minden összekötött épülete +2 létszámot ad, az épületek +250 életerőt kapnak. Járó fagomba-óriások védik a ligetet."
msgstr "Every connected building of the network gives +2 population, buildings gain +250 health. Walking bracket-fungus giants guard the grove."

msgctxt "path.mycel.liget.tagline"
msgid "Terjeszkedés és területfoglalás"
msgstr "Expansion and territory"

msgctxt "path.mycel.alom.name"
msgid "Álom"
msgstr "Dream"

msgctxt "path.mycel.alom.desc"
msgid "Az erdőben minden egységed láthatatlan, amíg nem mozog és nem támad. Álomsámánok és Álomszövők altató spórákkal bénítják meg az ellenfelet."
msgstr "In the forest all your units are invisible while they neither move nor attack. Dream shamans and Dreamweavers paralyse the enemy with sleeping spores."

msgctxt "path.mycel.alom.tagline"
msgid "Csel, rejtőzés, rajtaütés"
msgstr "Trickery, stealth, ambush"

msgctxt "unit.oon_lampasvivo.name"
msgid "Lámpásvivő"
msgstr ""

msgctxt "unit.oon_lampasvivo.desc"
msgid "Kis oni munkás: papírlámpást állít (a nép csak lámpásfényben építhet), épít, és végig ott marad az építkezésen. Nem gyűjt. Több munkás nem gyorsít, de egy közeli Taiko-dobos ritmusa +50%-kal igen."
msgstr ""

msgctxt "unit.oon_oni_harcos.name"
msgid "Oni harcos"
msgstr ""

msgctxt "unit.oon_oni_harcos.desc"
msgid "Vörös bőrű, szarvas oni, vasbuzogánnyal."
msgstr ""

msgctxt "unit.oon_kohajito.name"
msgid "Kőhajító oni"
msgstr ""

msgctxt "unit.oon_kohajito.desc"
msgid "Sziklákat hajít az ellenségre."
msgstr ""

msgctxt "unit.oon_nian_or.name"
msgid "Nian őrző"
msgstr ""

msgctxt "unit.oon_nian_or.desc"
msgid "Négylábú, zöld sörényű őrző. Kapuőrként egy épület mellé állhat: az épület páncélt kap, a nian helyben marad és védi."
msgstr ""

msgctxt "unit.oon_tengu.name"
msgid "Tengu követ"
msgstr ""

msgctxt "unit.oon_tengu.desc"
msgid "Szárnyas, hollótollú követ: legyezőjével szélvihart kavar."
msgstr ""

msgctxt "unit.oon_kitsune.name"
msgid "Kitsu-mata"
msgstr "Kitsu-mata"

msgctxt "unit.oon_kitsune.desc"
msgid "Az onik egyik változata, eredetileg nindzsaszerű harcos. Az égkövek használatát megtanulva tenyeréből mágikus lövedékeket lő ki: az Ooni sereg lövésze."
msgstr "Oni variant, once a ninja-like fighter. Having learned to use the sky-stones, it fires magic bolts from its palm: the Ooni archer."

msgctxt "unit.oon_illuzio_mas.name"
msgid "Illúzió-más"
msgstr ""

msgctxt "unit.oon_illuzio_mas.desc"
msgid "Rövid életű rókaszellem-másolat."
msgstr ""

msgctxt "unit.oon_kapudongeto.name"
msgid "Kapudöngető"
msgstr ""

msgctxt "unit.oon_kapudongeto.desc"
msgid "Faltörő kos, onik tolják – épületek ellen."
msgstr ""

msgctxt "unit.oon_o_oni.name"
msgid "Ō-oni"
msgstr ""

msgctxt "unit.oon_o_oni.desc"
msgid "Óriás oni, a hegyek ura."
msgstr ""

msgctxt "unit.oon_hos_akahana.name"
msgid "Akahana, a Vörös Buzogány"
msgstr ""

msgctxt "unit.oon_hos_akahana.desc"
msgid "Az onik vezére: rohamoz és földet rengeti."
msgstr ""

msgctxt "unit.oon_hos_shiro.name"
msgid "Shiro, a Kapuőr"
msgstr ""

msgctxt "unit.oon_hos_shiro.desc"
msgid "A fehér nian: védi a kapukat és a társait."
msgstr ""

msgctxt "unit.oon_hos_karasu.name"
msgid "Karasu, a tengu bölcs"
msgstr ""

msgctxt "unit.oon_hos_karasu.desc"
msgid "Az öreg tengu: szélvihart és villámot hív."
msgstr ""

msgctxt "unit.oon_berserker_oni.name"
msgid "Tomboló oni"
msgstr ""

msgctxt "unit.oon_berserker_oni.desc"
