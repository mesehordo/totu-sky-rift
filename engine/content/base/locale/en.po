msgstr ""

msgctxt "unit.oon_viharhivo.desc"
msgid "Villámot és tájfunt hív."
msgstr ""

msgctxt "unit.oon_favago.name"
msgid "Favágó oni"
msgstr ""

msgctxt "unit.oon_favago.desc"
msgid "Erős, széles vállú oni baltával: csak fát gyűjt, de egyszerre sokat (12). Harcban gyenge."
msgstr ""

msgctxt "unit.oon_tanuki.name"
msgid "Tanuki-bányász"
msgstr ""

msgctxt "unit.oon_tanuki.desc"
msgid "Alakváltó tanuki: aranyat és meteoritot bányászik. A bányák közelében, amíg nem harcol, álcázva dolgozik; néha egy-egy tárgyat is talál a mélyben (a leadóhelynél hagyja)."
msgstr ""

msgctxt "building.oon_nian_csarnok.name"
msgid "Nian csarnok"
msgstr ""

msgctxt "building.oon_nian_csarnok.desc"
msgid "Márványoszlopok, ívelt cseréptető, faragott nian-őrzők. Leadóhely; Lámpásvivőket, Favágó onikat és Tanuki-bányászokat nevel; fénye körül építhet a nép."
msgstr ""

msgctxt "building.oon_papirlampas.name"
msgid "Papírlámpás"
msgstr ""

msgctxt "building.oon_papirlampas.desc"
msgid "Olcsó lámpás: fénye bevilágít, tágítja az építési területet, és az Ooni egységek gyógyulnak benne."
msgstr ""

msgctxt "building.oon_lakohaz.name"
msgid "Oni lakóház"
msgstr ""

msgctxt "building.oon_lakohaz.desc"
