msgstr "Psionic horror. Unleashes the mist of madness on the enemy."

msgctxt "unit.cro_szarnyas_rem.name"
msgid "Szárnyas rém"
msgstr "Winged Dread"

msgctxt "unit.cro_szarnyas_rem.desc"
msgid "Hártyás szárnyú repülő ragadozó."
msgstr "A flying predator on membrane wings."

msgctxt "unit.cro_csapos_horror.name"
