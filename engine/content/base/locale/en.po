msgstr "Cheap, fast swarm unit. Two hatch from one larva."

msgctxt "unit.cro_tuskekopo.name"
msgid "Tüskeköpő"
msgstr "Spine Spitter"

msgctxt "unit.cro_tuskekopo.desc"
msgid "Csonttüskéket köp, földi és légi célpontokra."
msgstr "Spits bone spines at ground and air targets."

msgctxt "unit.cro_savkopo.name"
msgid "Savköpő"
msgstr "Acid Spitter"

msgctxt "unit.cro_savkopo.desc"
msgid "Élő tüzérség. Messzire köpött savhólyagok, terület-sebzés, bónusz épületek ellen."
msgstr "Living artillery. Long-range acid sacs, splash damage, bonus against buildings."

msgctxt "unit.cro_agyfalo.name"
