msgstr ""

msgctxt "research.oon_harci_dobok.desc"
msgid "A harci kedv 40%-kal lassabban fogy, a Taiko-dobos kétszer gyorsabban tölti."
msgstr ""

msgctxt "research.oon_verszomj.name"
