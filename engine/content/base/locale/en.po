msgstr ""

msgctxt "building.oon_torii.desc"
msgid "Kapupár egyik fele. Az elsőt lámpásfényben, a másodikat bárhová teheted, ahol épp látsz; a két kapu között az egységek átkelnek (jobb klikk a kapura, 2 mp, utána 8 mp töltődés). Kis lámpásfényt is ad."
msgstr ""

msgctxt "building.oon_egko.name"
msgid "Égkő"
msgstr ""

msgctxt "building.oon_egko.desc"
msgid "Lerakott meteoritszilánk: Égkő-fényt áraszt (5 csempe), mint egy meteorit – a mágiahasználók erősebbek, a meteoritrokon népek gyógyulnak. MINDENKINEK hat, és bárki lerombolhatja."
msgstr ""

