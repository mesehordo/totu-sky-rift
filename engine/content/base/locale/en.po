msgstr ""

msgctxt "research.oon_lampas_magia.desc"
msgid "A lámpásfényben álló varázslók 20%-kal erősebbek."
msgstr ""

msgctxt "faction.ooni.name"
msgid "Ooni"
msgstr ""

msgctxt "faction.ooni.desc"
msgid "Az onik és nianok közösségében a buzogányos harcosok mellett négylábú őrzők és szárnyas tengu követek is szolgálnak. Csarnokaik márványoszlopai fölé ívelt cseréptetők borulnak, kapuiknál faragott őrzők és papírlámpások állnak."
msgstr ""

msgctxt "faction.ooni.tagline"
msgid "Onik, nianok és tengu követek"
msgstr ""

msgctxt "path.ooni.voros.name"
msgid "Vörös buzogány"
msgstr ""

msgctxt "path.ooni.voros.desc"
msgid "Tomboló onik és harci dobok: a közelharcosok erősebbek és gyorsabbak, a Taiko-dobosok szívósabbak, és ritmusuk +75%-kal gyorsítja az építkezést. Korai, kemény nyomás."
msgstr ""

msgctxt "path.ooni.voros.tagline"
msgid "Oni roham"
msgstr ""

msgctxt "path.ooni.kapu.name"
msgid "Kapuőrzők"
msgstr ""

msgctxt "path.ooni.kapu.desc"
msgid "Kőkutya-őrök és lámpáspapok; az épületek és a nagy testű őrzők erősebbek. Lassú, áttörhetetlen védelem."
msgstr ""

msgctxt "path.ooni.kapu.tagline"
msgid "A nian-kapuk erőssége"
msgstr ""

msgctxt "path.ooni.tengu.name"
msgid "Tengu szél"
msgstr ""

msgctxt "path.ooni.tengu.desc"
msgid "Hollótengu-harcosok és viharhívók; a repülők gyorsabbak. Mozgékony, légi portyázó játék."
msgstr ""

msgctxt "path.ooni.tengu.tagline"
msgid "Légierő és vihar"
msgstr ""

msgctxt "unit.urs_telepes.name"
msgid "Telepes"
msgstr "Settler"

msgctxt "unit.urs_telepes.desc"
msgid "Munkás. Építéskor bemászik a félkész épületbe: bent védett, és csak készen jön ki. Javít, gyűjt."
msgstr "Worker. Builds (stays until it is done), repairs, gathers."

msgctxt "unit.urs_pajzshordozo.name"
msgid "Pajzshordozó"
msgstr "Shieldbearer"

msgctxt "unit.urs_pajzshordozo.desc"
msgid "Az ursan sereg gerince. Pajzsfal: a távolsági sebzés nagy részét elnyeli."
msgstr "Backbone of the Ursan army. Shield wall: absorbs most ranged damage."

msgctxt "unit.urs_szigonyvezo.name"
msgid "Szigonyvető"
msgstr "Harpooner"

msgctxt "unit.urs_szigonyvezo.desc"
msgid "Korai légvédelem: szigonya földi és légi célpontokat is eltalál, a repülő típus és a nagy testű célpontok ellen bónuszsebzést okoz."
msgstr "Early anti-air: harpoons hit ground and air targets, dealing bonus damage against flyer-type and large targets."

msgctxt "unit.urs_berserker.name"
msgid "Medvebőrös berserker"
msgstr "Bearskin Berserker"

msgctxt "unit.urs_berserker.desc"
msgid "Gyors, nagy sebzésű közelharcos."
msgstr "Fast, hard-hitting melee fighter."

msgctxt "unit.urs_runapap.name"
msgid "Rúnapap"
msgstr "Rune Priest"

msgctxt "unit.urs_runapap.desc"
msgid "Gyógyító. Automatikusan foltozza a sebesült harcosokat."
msgstr "Healer. Automatically patches up wounded warriors."

msgctxt "unit.urs_kardfogu.name"
msgid "Kardfogú lovas"
msgstr "Sabretooth Rider"

msgctxt "unit.urs_kardfogu.desc"
msgid "Kardfogú tigrisen lovagló gyors harcos. Roham képesség."
msgstr "Fast warrior riding a sabretooth tiger. Charge ability."

msgctxt "unit.urs_viharhollo.name"
msgid "Viharholló"
msgstr "Storm Raven"

msgctxt "unit.urs_viharhollo.desc"
msgid "Óriás holló. Felderítő és légvédelem."
msgstr "Giant raven. Scout and anti-air."

msgctxt "unit.urs_mammut.name"
msgid "Harci mammut"
msgstr "War Mammoth"

msgctxt "unit.urs_mammut.desc"
msgid "Gyapjas mamut, hátán kőhajítókkal. Terület-sebzés, bónusz épületek ellen."
msgstr "Woolly mammoth with stone throwers on its back. Splash damage, bonus against buildings."

msgctxt "unit.urs_hos_ragna.name"
msgid "Ragna Kőváll"
msgstr "Ragna Stoneshoulder"

msgctxt "unit.urs_hos_ragna.desc"
msgid "Egy határerőd parancsnoka. A pajzsa először a mellette állót védi."
msgstr "Commander of a border fort. Her shield protects the one beside her first."

msgctxt "unit.urs_dardaor.name"
msgid "Dárdaőr"
msgstr "Spear Guard"

msgctxt "unit.urs_dardaor.desc"
msgid "Hosszú dárdás védő – lovasság és nagy vadak ellen kiváló."
msgstr "Defender with a long spear – excellent against cavalry and large beasts."

msgctxt "unit.urs_ostromszan.name"
msgid "Ostromszán"
msgstr "Siege Sled"

msgctxt "unit.urs_ostromszan.desc"
msgid "Szánra szerelt kőhajító, épületek ellen. Felállítás: lövés előtt 2 mp-ig áll fel (utána +1 lőtáv), mozgás előtt 1 mp-ig csukódik össze."
msgstr "A stone thrower mounted on a sled, against buildings."

msgctxt "unit.urs_kardfogu_tigris.name"
msgid "Kardfogú tigris"
msgstr "Sabretooth Tiger"

msgctxt "unit.urs_kardfogu_tigris.desc"
msgid "Bjarka hívására érkező vadállat (idézett)."
msgstr "A beast answering Bjarka's call (summoned)."

msgctxt "unit.urs_hos_hjalmar.name"
msgid "Hjalmar Fagyjós"
msgstr "Hjalmar Frostseer"

msgctxt "unit.urs_hos_hjalmar.desc"
msgid "A jégkorszak emlékét őrző jós: fagy, vihar és lassítás."
msgstr "A seer keeping the memory of the ice age: frost, storm and slowing."

msgctxt "unit.urs_hos_bjarka.name"
msgid "Bjarka, a Vadak Ura"
msgstr "Bjarka, Lord of Beasts"

msgctxt "unit.urs_hos_bjarka.desc"
msgid "Vadász és vadidomár: kardfogú tigriseket és mamutokat hív harcba."
msgstr "Hunter and beast tamer: calls sabretooth tigers and mammoths to battle."

msgctxt "unit.urs_runako.name"
msgid "Rúnakő"
msgstr "Rune Stone"

msgctxt "unit.urs_runako.desc"
msgid "Rúnapap által állított kő (idézett). Aurája véd és gyógyít."
msgstr "A stone raised by a Rune Priest (summoned). Its aura protects and heals."

msgctxt "unit.urs_medvealak.name"
msgid "Medvealakváltó"
msgstr "Bear Shapeshifter"

msgctxt "unit.urs_medvealak.desc"
msgid "Az ursan teljesen medvévé változik: hatalmas karmok, rettentő üvöltés."
msgstr "The Ursan turns fully into a bear: huge claws, a terrifying roar."

msgctxt "unit.urs_kurtos.name"
msgid "Harci kürtös"
msgstr "War Hornblower"

msgctxt "unit.urs_kurtos.desc"
msgid "Kürtszava felszítja a harcosokat: +15% sebzés, +10% sebesség a közelben."
msgstr "The horn call stirs the warriors: +15% damage, +10% speed nearby."

msgctxt "unit.urs_runaorias.name"
msgid "Rúnaóriás"
msgstr "Rune Giant"

msgctxt "unit.urs_runaorias.desc"
msgid "Rúnákkal életre keltett kőóriás: lassú, de épületeket zúz."
msgstr "A stone giant awakened by runes: slow, but it smashes buildings."

msgctxt "building.urs_nagyterem.name"
msgid "Nagyterem"
msgstr "Great Hall"

msgctxt "building.urs_nagyterem.desc"
msgid "Faragott hosszúcsarnok, főépület. Leadóhely, Telepeseket képez."
msgstr "Carved longhall, main building. Drop-off, trains Settlers."

msgctxt "building.urs_hosszuhaz.name"
msgid "Hosszúház"
msgstr "Longhouse"

msgctxt "building.urs_hosszuhaz.desc"
msgid "Erődített hosszúház: 4 fős helyőrség, riadóban a telepesek menedéke."
msgstr "Fortified longhouse: garrison of 4, the settlers' refuge in an alarm."

msgctxt "building.urs_fatelep.name"
msgid "Fatelep"
msgstr "Lumber Yard"

msgctxt "building.urs_fatelep.desc"
msgid "Leadóhely fának, aranynak és meteoritnak."
msgstr "Drop-off for wood, stone and meteorite."

msgctxt "building.urs_harcosok_haza.name"
msgid "Harcosok háza"
msgstr "House of Warriors"

msgctxt "building.urs_harcosok_haza.desc"
msgid "Pajzshordozókat, dárdaőröket és szigonyvetőket képez. A szigonyvetők korai légvédelmet adnak."
msgstr "Trains Shieldbearers, Spear Guards and Harpooners. Harpooners provide early anti-air defense."

msgctxt "building.urs_runakovacs.name"
msgid "Rúnakovács"
msgstr "Rune Forge"

msgctxt "building.urs_runakovacs.desc"
msgid "Rúnapapokat képez, fegyvert és páncélt fejleszt."
msgstr "Trains Rune Priests and Siege Sleds, upgrades weapons and armour."

msgctxt "building.urs_vadak_karama.name"
msgid "Vadak karáma"
msgstr "Beast Pen"

msgctxt "building.urs_vadak_karama.desc"
msgid "Kardfogú lovasokat és harci mamutokat nevel."
msgstr "Raises Sabretooth Riders and War Mammoths."

msgctxt "building.urs_sasszirt.name"
msgid "Sasszirt"
msgstr "Eagle Crag"

msgctxt "building.urs_sasszirt.desc"
msgid "Viharhollókat nevel."
msgstr "Raises Storm Ravens."

msgctxt "building.urs_ortorony.name"
msgid "Őrtorony"
msgstr "Watchtower"

msgctxt "building.urs_ortorony.desc"
msgid "Fa-kő őrtorony íjászokkal."
msgstr "Wood-and-stone watchtower with archers."

msgctxt "building.urs_eskufa.name"
msgid "Esküfa"
msgstr "Oath Tree"

msgctxt "building.urs_eskufa.desc"
msgid "Ősi kőris, amely alatt a jarlok esküt tesznek: Ragna, Hjalmar és Bjarka."
msgstr "An ancient ash under which the jarls swear their oaths: Ragna, Hjalmar and Bjarka."

msgctxt "building.urs_tanya.name"
msgid "Tanya"
msgstr "Farmstead"

msgctxt "building.urs_tanya.desc"
msgid "Árpaföld, ólak és szénapajták: a jarlság népe innen él. +10 létszám."
msgstr "Barley field, sheds and hay barns: the jarldom lives off it. +10 population."

msgctxt "building.urs_colopfal.name"
msgid "Cölöpfal"
msgstr "Palisade"

msgctxt "building.urs_colopfal.desc"
msgid "Hegyes karókból álló falszakasz – elzárja az utat. Olcsó, gyorsan épül; a telepesek javítják."
msgstr "A wall section of sharpened stakes – blocks the way. Cheap and quick to build; settlers repair it."

msgctxt "building.urs_verfogadalom.name"
msgid "Vérfogadalom-csarnok"
msgstr "Hall of the Blood Oath"

msgctxt "building.urs_verfogadalom.desc"
msgid "Itt teszik le a berserkerek a vérfogadalmat."
msgstr "Here the berserkers swear their blood oath."

msgctxt "building.urs_runaszentely.name"
msgid "Rúnaszentély"
msgstr "Rune Sanctum"

msgctxt "building.urs_runaszentely.desc"
msgid "Rúnakőkör kovácsműhellyel: rúnaóriások és ostromszánok."
msgstr "A rune-stone circle with a forge: rune giants and siege sleds."

msgctxt "building.urs_diplomacia.name"
msgid "Diplomácia csarnoka"
msgstr ""

msgctxt "building.urs_diplomacia.desc"
msgid "Itt köthetsz szövetséget egy kisebb néppel (egyszer, véglegesen). A szövetség után a nép épületei a munkásaid építési listáján jelennek meg."
msgstr ""

msgctxt "building.urs_egko.name"
msgid "Égkő"
msgstr ""

msgctxt "building.urs_egko.desc"
msgid "Lerakott meteoritszilánk: Égkő-fényt áraszt (5 csempe), mint egy meteorit – a mágiahasználók erősebbek, a meteoritrokon népek gyógyulnak. MINDENKINEK hat, és bárki lerombolhatja."
msgstr ""

msgctxt "research.urs_runapengek.name"
msgid "Rúnás pengék"
msgstr "Rune Blades"

msgctxt "research.urs_runapengek.desc"
msgid "+2 sebzés a közelharci egységeknek."
msgstr "+2 damage for melee units."

msgctxt "research.urs_vasszigony.name"
msgid "Vashegyű szigonyok"
msgstr "Iron-tipped Harpoons"

msgctxt "research.urs_vasszigony.desc"
msgid "+2 sebzés a távolsági egységeknek."
msgstr "+2 damage for ranged units."

msgctxt "research.urs_medvebunda.name"
msgid "Medvebunda-páncél"
msgstr "Bear-pelt Armour"

msgctxt "research.urs_medvebunda.desc"
msgid "+1 páncél minden élő egységnek."
msgstr "+1 armour for every living unit."

msgctxt "research.urs_telegi_edzes.name"
msgid "Télegi edzés"
msgstr "Winter Training"

msgctxt "research.urs_telegi_edzes.desc"
msgid "+25 életerő a gyalogságnak és a lovasságnak."
msgstr "+25 health for infantry and cavalry."

msgctxt "research.urs_nepfelkeles.name"
msgid "Népfelkelés"
msgstr ""

msgctxt "research.urs_nepfelkeles.desc"
msgid "A telepesek harcosként is megállják a helyüket: +5 sebzés, +40 életerő, +1 páncél; és megnyílik a „Fegyverbe!” riadó."
msgstr ""

msgctxt "research.urs_runapajzs.name"
msgid "Rúnapajzs"
msgstr ""

msgctxt "research.urs_runapajzs.desc"
msgid "Rúnák az épületeken: minden épület +2 páncélt kap, és lassan magától javul (+1 életerő/mp)."
msgstr ""

msgctxt "research.urs_kiados_tanya.name"
msgid "Kiadós tanya"
msgstr ""

msgctxt "research.urs_kiados_tanya.desc"
msgid "A Tanyák +4 létszámot adnak (8 helyett 12)."
msgstr ""

msgctxt "research.urs_medve_osztön.name"
msgid "Medve-ösztön"
msgstr ""

msgctxt "research.urs_medve_osztön.desc"
msgid "Vérszag: a 40% életerő alá sebesült ursan egységek 20%-kal nagyobbat sebeznek."
msgstr ""

msgctxt "research.urs_gyors_helyorseg.name"
msgid "Lőréses falak"
msgstr ""

msgctxt "research.urs_gyors_helyorseg.desc"
msgid "A helyőrségbe húzódott egységek erősebben lőnek ki (+7 sebzés fejenként a +4 helyett)."
msgstr ""

msgctxt "research.urs_runapengek_2.name"
msgid "Rúnás pengék II."
msgstr ""

msgctxt "research.urs_runapengek_2.desc"
msgid "+2 sebzés a közelharci egységeknek. (II. szint)"
msgstr ""

msgctxt "research.urs_runapengek_3.name"
msgid "Rúnás pengék III."
msgstr ""

msgctxt "research.urs_runapengek_3.desc"
msgid "+2 sebzés a közelharci egységeknek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.urs_vasszigony_2.name"
msgid "Vashegyű szigonyok II."
msgstr ""

msgctxt "research.urs_vasszigony_2.desc"
msgid "+2 sebzés a távolsági egységeknek. (II. szint)"
msgstr ""

msgctxt "research.urs_vasszigony_3.name"
msgid "Vashegyű szigonyok III."
msgstr ""

msgctxt "research.urs_vasszigony_3.desc"
msgid "+2 sebzés a távolsági egységeknek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.urs_medvebunda_2.name"
msgid "Medvebunda-páncél II."
msgstr ""

msgctxt "research.urs_medvebunda_2.desc"
msgid "+1 páncél minden élő egységnek. (II. szint)"
msgstr ""

msgctxt "research.urs_medvebunda_3.name"
msgid "Medvebunda-páncél III."
msgstr ""

msgctxt "research.urs_medvebunda_3.desc"
msgid "+1 páncél minden élő egységnek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.urs_tuskes_pajzsfal.name"
msgid "Tüskés pajzsfal"
msgstr ""

msgctxt "research.urs_tuskes_pajzsfal.desc"
msgid "A Pajzshordozók nem gyengék a közelharcosok és az ostromgépek ellen."
msgstr ""

msgctxt "faction.ursan.name"
msgid "Ursanok"
msgstr "Ursans"

msgctxt "faction.ursan.desc"
msgid "Az Északi Eskük Birodalma: esküvel összekötött jarlságok, jurtákkal kevert hosszúcsarnokok, árpaföldes tanyák. Sisakot nem hordanak, legfeljebb ágyékkötőt; nagy, lapos deszkapajzzsal harcolnak. A csarnokok és tornyok helyőrséget fogadnak (riadókor a telepesek is behúzódnak), a létszámot a tanyák adják. Pajzsfal és jégkorszaki harci vadak."
msgstr "The Empire of the Northern Oaths: jarldoms bound by oath, longhalls mixed with yurts, barley farmsteads. They wear no helmets, at most a loincloth, and fight with great flat plank shields. Halls and towers take in garrisons (in an alarm the settlers hide inside too); their numbers are fed by farmsteads. Shield walls and ice-age war beasts."

msgctxt "faction.ursan.tagline"
msgid "Helyőrség • tanyák • javítás • pajzsfal"
msgstr "Garrisons • farmsteads • repair • shield wall"

msgctxt "path.ursan.berserker.name"
msgid "Berserker-klán"
msgstr "Berserker Clan"

msgctxt "path.ursan.berserker.desc"
msgid "Vérfogadalom: a közelharcosok annál erősebbek, minél sebesültebbek (+60% sebzésig). Berserkerek, medvévé változó alakváltók és harci kürtösök."
msgstr "Blood oath: melee fighters grow stronger the more wounded they are (up to +60% damage). Berserkers, shapeshifters who turn into bears, and war hornblowers."

msgctxt "path.ursan.berserker.tagline"
msgid "Korai, nyers közelharci nyomás"
msgstr "Early, raw melee pressure"

msgctxt "path.ursan.runa.name"
msgid "Rúnakovácsok"
msgstr "Runesmiths"

msgctxt "path.ursan.runa.desc"
msgid "Rúnákkal vésett falak és tornyok: +3 páncél minden épületnek, +6 toronysebzés. Rúnaóriások és ostromszánok törik át a frontot, amikor már minden megvan."
msgstr "Rune-carved walls and towers: +3 armour for every building, +6 tower damage. Rune giants and siege sleds break the front once everything is in place."

msgctxt "path.ursan.runa.tagline"
msgid "Erőd, technológia, késői erő"
msgstr "Fortress, technology, late-game power"

msgctxt "path.ursan.tundra.name"
msgid "Tundra hívása"
msgstr "Call of the Tundra"

msgctxt "path.ursan.tundra.desc"
msgid "Mamutok, kardfogú lovasok és viharhollók. A vadállatok és a lovasság +60 életerőt és gyorsabb regenerációt kapnak. Lassú, nehéz ostrom."
msgstr "Mammoths, sabre-tooth riders and storm ravens. Beasts and cavalry gain +60 health and faster regeneration. A slow, heavy siege."

msgctxt "path.ursan.tundra.tagline"
msgid "Nagytestű vadak, kevés, de hatalmas egység"
msgstr "Great beasts – few, but huge units"

msgctxt "unit.vad_kristalybogar.name"
msgid "Kristálybogár"
msgstr "Crystal Beetle"

msgctxt "unit.vad_kristalybogar.desc"
msgid "Csillagérctől megnőtt bogár; páncélján kristályok nőnek."
msgstr "A beetle grown huge from star-ore; crystals grow on its shell."

msgctxt "unit.vad_hamufarkas.name"
msgid "Hamufarkas"
msgstr "Ash Wolf"

msgctxt "unit.vad_hamufarkas.desc"
msgid "A becsapódás hamujában élő falkavad."
msgstr "A pack beast living in the ash of the impact."

msgctxt "unit.vad_eterliderc.name"
msgid "Éterlidérc"
msgstr "Ether Wisp"

msgctxt "unit.vad_eterliderc.desc"
msgid "Szabadon kóborló étercsomó – egykor talán egy lélek volt."
msgstr "A freely wandering knot of ether – once perhaps a soul."

msgctxt "unit.vad_kotroll.name"
msgid "Kőtroll"
msgstr "Stone Troll"

msgctxt "unit.vad_kotroll.desc"
msgid "Hegyi óriás, bőrébe kristályok nőttek."
msgstr "A mountain giant with crystals grown into its skin."

msgctxt "unit.vad_ercgolem.name"
msgid "Csillagérc-gólem"
msgstr "Star-ore Golem"

msgctxt "unit.vad_ercgolem.desc"
msgid "A Fekete Tükör pereméről indult élő érctömb. A vadon ura."
msgstr "A living lump of ore that set out from the rim of the Black Mirror. Lord of the wild."

msgctxt "faction.vadon.name"
msgid "Vadon"
msgstr "The Wild"

msgctxt "faction.vadon.desc"
msgid "A Fényes Eső óta a vadonban éterrel átitatott lények őrzik a kristálylelőhelyeket és a kincseket."
msgstr "Since the Bright Rain, ether-soaked creatures of the wild guard the crystal deposits and the treasures."

msgctxt "faction.vadon.tagline"
msgid "Semleges szörnyek"
msgstr "Neutral monsters"

msgctxt "unit.wul_gyujtogeto.name"
msgid "Gyűjtögető"
msgstr "Gatherer"

msgctxt "unit.wul_gyujtogeto.desc"
msgid "Munkás. Fát csapol: a fához kötődik, és hordás nélkül, lassan, folyamatosan jön a fa (egy fán egy csapoló). Aranyat hord, javít; építéskor mellette állva dolgozik; többen együtt gyorsabban építenek."
msgstr "Worker. Gathers, builds, repairs; carries the haul in a woven back basket."

msgctxt "unit.wul_landzsas.name"
msgid "Lándzsás harcos"
msgstr "Spear Warrior"

msgctxt "unit.wul_landzsas.desc"
msgid "Gyors, kovakőhegyű lándzsás, keskeny festett hárítópajzzsal; dárdavetővel (woomera) messzire is hajít. Falkában erős."
msgstr "A fast warrior with a flint spear and a narrow painted parrying shield. Dangerous in a pack."

msgctxt "unit.wul_ijas_vadasz.name"
msgid "Bumerángvető"
msgstr "Boomerang Thrower"

msgctxt "unit.wul_ijas_vadasz.desc"
msgid "Távolsági vadász: a bumeráng visszatérő íven a közeli ellenségeket is eltalálja. Földi és légi célpontokra."
msgstr "A ranged hunter: the boomerang's returning arc also strikes nearby enemies. Hits ground and air."

msgctxt "unit.wul_holdsaman.name"
msgid "Holdsámán"
msgstr "Moon Shaman"

msgctxt "unit.wul_holdsaman.desc"
msgid "Gyógyít, és szellemfarkasokat hív a holdfényből."
msgstr "Heals, and calls spirit wolves from the moonlight."

msgctxt "unit.wul_szellemfarkas.name"
msgid "Szellemfarkas"
msgstr "Spirit Wolf"

msgctxt "unit.wul_szellemfarkas.desc"
msgid "A holdfényből idézett szellem-dingó. Fél percig él."
msgstr "A spirit dingo called from the moonlight. Lives for half a minute."

msgctxt "unit.wul_bolenylovas.name"
msgid "Bölénylovas"
msgstr "Bison Rider"

msgctxt "unit.wul_bolenylovas.desc"
msgid "Bölényen ülő wullof harcos: erős roham. Le is szállhat."
msgstr "A Wullof warrior riding a bison: a mighty charge. Can also dismount."

msgctxt "unit.wul_mennydorgesmadar.name"
msgid "Viharkakadu"
msgstr "Storm Cockatoo"

msgctxt "unit.wul_mennydorgesmadar.desc"
msgid "Óriás viharkakadu; villámai a célpont környékét is sújtják."
msgstr "A giant storm cockatoo; its lightning also strikes around the target."

msgctxt "unit.wul_totemorias.name"
msgid "Termeszvár-óriás"
msgstr "Termite-mound Giant"

msgctxt "unit.wul_totemorias.desc"
msgid "Életre kelt vörös termeszvár – lassú, de az épületeket porrá zúzza."
msgstr "A red termite mound come to life – slow, but it grinds buildings to dust."

msgctxt "unit.wul_vandorszeker.name"
msgid "Vándorbatyu"
msgstr "Bundle Camp"

msgctxt "unit.wul_vandorszeker.desc"
msgid "Felszedett tábor, rudakra kötve. Jobb gomb: Letelepítés máshol."
msgstr "A packed-up camp tied to poles. Right-click: settle elsewhere."

msgctxt "unit.wul_hos_tava.name"
msgid "Tava"
msgstr "Tava"

msgctxt "unit.wul_hos_tava.desc"
msgid "Folyami térképész és követ a Hét Út Szövetségéből. Utat nyit és felderít."
msgstr "River cartographer and envoy of the Alliance of the Seven Roads. Opens roads and scouts."

msgctxt "unit.wul_tomahawkos.name"
msgid "Dárdavető portyázó"
msgstr "Spear-thrower Raider"

msgctxt "unit.wul_tomahawkos.desc"
msgid "Gyors portyázó dárdavetővel (woomera): a munkások és a távolsági egységek réme."
msgstr "A fast raider with a woomera: the terror of workers and ranged units."

msgctxt "unit.wul_hos_varnu.name"
msgid "Varnu, a Holdsámán"
msgstr "Varnu the Moon Shaman"

msgctxt "unit.wul_hos_varnu.desc"
msgid "Az ősök szellemeivel beszél: gyógyít, ködöt és szellemfalkát hív."
msgstr "Speaks with the spirits of the ancestors: heals, calls mist and a spirit pack."

msgctxt "unit.wul_hos_kurrin.name"
msgid "Kurrin Harcfőnök"
msgstr "Warchief Kurrin"

msgctxt "unit.wul_hos_kurrin.desc"
msgid "Harci bölényen lovagló harcfőnök: tapos, üvölt, és a Hét Út harcosait hívja."
msgstr "A warchief riding a war bison: tramples, howls, and calls the warriors of the Seven Roads."

msgctxt "unit.wul_emu.name"
msgid "Emu"
msgstr "Emu"

msgctxt "unit.wul_emu.desc"
msgid "Tenyészemu: +6 létszám. Emukarámonként legfeljebb 5 tartható."
msgstr "Breeding emu: +6 population. At most 5 per Emu Pen."

msgctxt "unit.wul_boleny.name"
msgid "Bölény"
msgstr "Bison"

msgctxt "unit.wul_boleny.desc"
msgid "Erős, de lassú bölény. Felültethető rá egy wullof gyalogos harcos."
msgstr "A strong but slow bison. A Wullof foot warrior can be mounted on it."

msgctxt "unit.wul_groomi.name"
msgid "Groomi"
msgstr "Groomi"

msgctxt "unit.wul_groomi.desc"
msgid "Piros szörnymadár: gyors, harapós földi vadász. A Groomi-fészekben sav-, tűz- vagy fagyköpést tanulhat (csak egyet)."
msgstr "A red monster bird: a fast, biting ground hunter. In the Groomi Nest it can learn acid, fire or frost spit (only one)."

msgctxt "unit.wul_csordavezer.name"
msgid "Csordavezér bika"
msgstr "Herd-leader Bull"

msgctxt "unit.wul_csordavezer.desc"
msgid "Hatalmas bölénybika: épületeket tipor, rohamában mindent elsöpör."
msgstr "A huge bison bull: tramples buildings and sweeps everything aside in its charge."

msgctxt "unit.wul_groomi_fioka.name"
msgid "Groomi-fióka"
msgstr "Groomi Chick"

msgctxt "unit.wul_groomi_fioka.desc"
msgid "Kicsi, de fürge és harapós Groomi."
msgstr "A small but nimble, bitey Groomi."

msgctxt "unit.wul_groomi_anya.name"
msgid "Groomi-anya"
msgstr "Groomi Mother"

msgctxt "unit.wul_groomi_anya.desc"
msgid "Óriás Groomi-tojó: fiókákat keltet, és keményen harap."
msgstr "A giant Groomi hen: hatches chicks and bites hard."

msgctxt "unit.wul_totemfarago.name"
msgid "Totemfaragó"
msgstr "Totem Carver"

msgctxt "unit.wul_totemfarago.desc"
msgid "Ősök-dalát éneklő faragó: a közeli szövetségesek +2 páncélt kapnak."
msgstr "A carver singing the Ancestors' song: nearby allies gain +2 armour."

msgctxt "unit.wul_alomjaro.name"
msgid "Álomjáró"
msgstr "Dreamwalker"

msgctxt "unit.wul_alomjaro.desc"
msgid "Az ősök álmait járja: álomködöt borít az ellenségre, és az álmok útján ugrik egyik helyről a másikra."
msgstr "Walks the dreams of the ancestors: heals and calls spirit wolves."

msgctxt "unit.wul_ijas_vadasz_falka.name"
msgid "Bumerángvető-falka (3)"
msgstr ""

msgctxt "unit.wul_ijas_vadasz_falka.desc"
msgid "Három Bumerángvető egyszerre, olcsóbban. (Falkaharc kutatás kell hozzá.)"
msgstr ""

msgctxt "unit.wul_landzsas_falka.name"
msgid "Lándzsás harcos-falka (3)"
msgstr ""

msgctxt "unit.wul_landzsas_falka.desc"
msgid "Három Lándzsás harcos egyszerre, olcsóbban."
msgstr ""

msgctxt "building.wul_tanacssator.name"
msgid "Tanácskunyhó"
msgstr "Council Hut"

msgctxt "building.wul_tanacssator.desc"
msgid "A törzs nagy kéregkunyhója. Leadóhely, Gyűjtögetőket nevel. Felszedhető."
msgstr "The tribe's great bark hut. Drop-off point, trains Gatherers. Can be packed up."

msgctxt "building.wul_tipi.name"
msgid "Kéregkunyhó"
msgstr "Bark Hut"

msgctxt "building.wul_tipi.desc"
msgid "Eukaliptuszkéreg-kunyhó: Lándzsás harcosokat képez. Felszedhető."
msgstr "Eucalyptus-bark hut: trains Spear Warriors. Can be packed up."

msgctxt "building.wul_harcosok_tuze.name"
msgid "Harcosok tüze"
msgstr "Warriors' Fire"

msgctxt "building.wul_harcosok_tuze.desc"
msgid "Dárdavetőket és bumerángvetőket képez. Felszedhető."
msgstr "Trains spear-throwers and boomerang throwers. Can be packed up."

msgctxt "building.wul_bolenykaram.name"
msgid "Emukarám"
msgstr "Emu Pen"

msgctxt "building.wul_bolenykaram.desc"
msgid "Emukat tenyészt (karámonként legfeljebb 5). Csak az emuk növelik a létszámot. Felszedhető."
msgstr "Breeds emus (at most 5 per pen). Only emus raise the population limit. Can be packed up."

msgctxt "building.wul_samansator.name"
msgid "Sámánkunyhó"
msgstr "Shaman's Hut"

msgctxt "building.wul_samansator.desc"
msgid "Holdsámánokat képez, fejlesztéseket kutat. Felszedhető."
msgstr "Trains Moon Shamans and researches upgrades. Can be packed up."

msgctxt "building.wul_mennydorges_szikla.name"
msgid "Vörös szikla"
msgstr "Red Rock"

msgctxt "building.wul_mennydorges_szikla.desc"
msgid "A viharkakaduk fészke a pusztai vörös sziklán."
msgstr "The storm cockatoos nest on the red rock of the plains."

msgctxt "building.wul_szellemtotem.name"
msgid "Eukaliptusz-őrfa"
msgstr "Eucalyptus Lookout"

msgctxt "building.wul_szellemtotem.desc"
msgid "Kilátós őrfa: a fenti vadászok bumerángokkal védik a tábort."
msgstr "A lookout tree: the hunters above guard the camp with boomerangs."

msgctxt "building.wul_osok_kore.name"
msgid "Ősök köre"
msgstr "Circle of Ancestors"

msgctxt "building.wul_osok_kore.desc"
msgid "Faragott oszlopok köre: Tava, Varnu és Kurrin hívása. Felszedhető."
msgstr "A circle of carved posts: calls Tava, Varnu and Kurrin. Can be packed up."

msgctxt "building.wul_bolenyakol.name"
msgid "Bölénykarám"
msgstr "Bison Corral"

msgctxt "building.wul_bolenyakol.desc"
msgid "Bölényeket és Csordavezér bikákat képez. Felszedhető."
msgstr "Provides Bison and Termite-mound Giants. Can be packed up."

msgctxt "building.wul_groomi_feszek.name"
msgid "Groomi-fészek"
msgstr "Groomi Nest"

msgctxt "building.wul_groomi_feszek.desc"
msgid "Groomikat nevel; itt választható ki a köpésük."
msgstr "Raises Groomis; their spit is chosen here."

msgctxt "building.wul_totemkert.name"
msgid "Totemkert"
msgstr "Totem Garden"

msgctxt "building.wul_totemkert.desc"
msgid "Faragott totemek kertje: Totemfaragókat, Álomjárókat és termeszvár-óriásokat ad."
msgstr "A garden of carved totems: provides Totem Carvers, Dreamwalkers and Termite-mound Giants."

msgctxt "building.wul_diplomacia.name"
msgid "Diplomácia csarnoka"
msgstr ""

msgctxt "building.wul_diplomacia.desc"
msgid "Itt köthetsz szövetséget egy kisebb néppel (egyszer, véglegesen). A szövetség után a nép épületei a munkásaid építési listáján jelennek meg."
msgstr ""

msgctxt "building.wul_egko.name"
msgid "Égkő"
msgstr ""

msgctxt "building.wul_egko.desc"
msgid "Lerakott meteoritszilánk: Égkő-fényt áraszt (5 csempe), mint egy meteorit – a mágiahasználók erősebbek, a meteoritrokon népek gyógyulnak. MINDENKINEK hat, és bárki lerombolhatja."
msgstr ""

msgctxt "research.wul_obszidian_landzsa.name"
msgid "Kovakő lándzsahegyek"
msgstr "Flint Spearheads"

msgctxt "research.wul_obszidian_landzsa.desc"
msgid "+2 sebzés a közelharci egységeknek."
msgstr "+2 damage for melee units."

msgctxt "research.wul_holdfeny_ijak.name"
msgid "Vasfa bumerángok"
msgstr "Ironwood Boomerangs"

msgctxt "research.wul_holdfeny_ijak.desc"
msgid "+2 sebzés a távolsági egységeknek."
msgstr "+2 damage for ranged units."

msgctxt "research.wul_bolenybor.name"
msgid "Kengurubőr vértek"
msgstr "Kangaroo-hide Armour"

msgctxt "research.wul_bolenybor.desc"
msgid "+1 páncél minden élő egységnek."
msgstr "+1 armour for every living unit."

msgctxt "research.wul_falkaszellem.name"
msgid "A falka szelleme"
msgstr "Spirit of the Pack"

msgctxt "research.wul_falkaszellem.desc"
msgid "+10% sebesség minden egységnek."
msgstr "+10% speed for every unit."

msgctxt "research.wul_savkopes.name"
msgid "Savköpés"
msgstr "Acid Spit"

msgctxt "research.wul_savkopes.desc"
msgid "A Groomik maró, mérgező savat köphetnek. Csak egy köpésfajta választható: ha ezt kifejleszted, a másik kettő többé nem fejleszthető."
msgstr "Groomis can spit corrosive, poisonous acid. Only one spit can be chosen: once you research this, the other two can never be researched."

msgctxt "research.wul_tuzkopes.name"
msgid "Tűzköpés"
msgstr "Fire Spit"

msgctxt "research.wul_tuzkopes.desc"
msgid "A Groomik lángcsóvát köphetnek. Csak egy köpésfajta választható: ha ezt kifejleszted, a másik kettő többé nem fejleszthető."
msgstr "Groomis can spit a jet of flame. Only one spit can be chosen: once you research this, the other two can never be researched."

msgctxt "research.wul_fagykopes.name"
msgid "Fagyköpés"
msgstr "Frost Spit"

msgctxt "research.wul_fagykopes.desc"
msgid "A Groomik jeges köpetet köphetnek. Csak egy köpésfajta választható: ha ezt kifejleszted, a másik kettő többé nem fejleszthető."
msgstr "Groomis can spit icy slime. Only one spit can be chosen: once you research this, the other two can never be researched."

msgctxt "research.wul_zsakmanyszerzes.name"
msgid "Zsákmányszerzés"
msgstr ""

msgctxt "research.wul_zsakmanyszerzes.desc"
msgid "A vadászzsákmány (ölésből) aranyat is hoz: a fa-zsákmány felét."
msgstr ""

msgctxt "research.wul_falkaharc.name"
msgid "Falkaharc"
msgstr ""

msgctxt "research.wul_falkaharc.desc"
msgid "A Lándzsás harcosok és a Bumerángvetők falkában (hármasával, olcsóbban) is képezhetők: a képző épületen a „Falkában képez” kapcsolóval."
msgstr ""

msgctxt "research.wul_bolenylovaglas.name"
msgid "Bölénylovaglás"
msgstr ""

msgctxt "research.wul_bolenylovaglas.desc"
msgid "A wullof gyalogos harcosok felülhetnek a bölényre (a Bölény Felültetés gombja): Bölénylovas lesz belőlük."
msgstr ""

msgctxt "research.wul_obszidian_landzsa_2.name"
msgid "Kovakő lándzsahegyek II."
msgstr ""

msgctxt "research.wul_obszidian_landzsa_2.desc"
msgid "+2 sebzés a közelharci egységeknek. (II. szint)"
msgstr ""

msgctxt "research.wul_obszidian_landzsa_3.name"
msgid "Kovakő lándzsahegyek III."
msgstr ""

msgctxt "research.wul_obszidian_landzsa_3.desc"
msgid "+2 sebzés a közelharci egységeknek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.wul_holdfeny_ijak_2.name"
msgid "Vasfa bumerángok II."
msgstr ""

msgctxt "research.wul_holdfeny_ijak_2.desc"
msgid "+2 sebzés a távolsági egységeknek. (II. szint)"
msgstr ""

msgctxt "research.wul_holdfeny_ijak_3.name"
msgid "Vasfa bumerángok III."
msgstr ""

msgctxt "research.wul_holdfeny_ijak_3.desc"
msgid "+2 sebzés a távolsági egységeknek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.wul_bolenybor_2.name"
msgid "Kengurubőr vértek II."
msgstr ""

msgctxt "research.wul_bolenybor_2.desc"
msgid "+1 páncél minden élő egységnek. (II. szint)"
msgstr ""

msgctxt "research.wul_bolenybor_3.name"
msgid "Kengurubőr vértek III."
msgstr ""

msgctxt "research.wul_bolenybor_3.desc"
msgid "+1 páncél minden élő egységnek. (III. szint; a Felemelkedés után)"
msgstr ""

msgctxt "research.wul_nyomolvasas.name"
msgid "Ősi nyomolvasás"
msgstr ""

msgctxt "research.wul_nyomolvasas.desc"
msgid "A wullof egységek 8 csempén belül felfedik a láthatatlan ellenséget."
msgstr ""

msgctxt "research.wul_holdtolte.name"
msgid "Holdtölte"
msgstr ""

msgctxt "research.wul_holdtolte.desc"
msgid "Minden 4. percben 1 percig telihold van: a wullof egységek 15%-kal nagyobbat sebeznek."
msgstr ""

msgctxt "faction.wullof.name"
msgid "Wullof"
msgstr "Wullof"

msgctxt "faction.wullof.desc"
msgid "A Hét Út Szövetsége: dingónép folyóvárosokkal, vándorló közösségekkel és útének-dalokkal a vörös pusztán és az eukaliptuszerdőkben. A táboraik felszedhetők és máshol letelepíthetők; a létszámot az emucsordák adják, falkában erősebbek, és minden zsákmány fát hoz a törzsnek."
msgstr "The Alliance of the Seven Roads: a dingo people of river towns, wandering communities and road-songs on the red plains and in the eucalyptus forests. Their camps can be packed up and pitched elsewhere; emu herds provide the population, they are stronger as a pack, and every kill brings wood to the tribe."

msgctxt "faction.wullof.tagline"
msgid "Nomád táborok • falkaerő • vadászzsákmány"
msgstr "Nomad camps • pack strength • hunting spoils"

msgctxt "path.wullof.boleny.name"
msgid "Bölény-csorda"
msgstr "Bison Herd"

msgctxt "path.wullof.boleny.desc"
msgid "Bölényeket nevelsz, és a harcosaid felülnek rájuk. A lovasság és a vadállatok gyorsabbak és erősebbek; a Csordavezér bika épületeket tipor. Középjátékban egyetlen, döntő rohamra épít."
msgstr "You raise bison and your warriors mount them. Cavalry and beasts are faster and stronger; the Herd-leader Bull tramples buildings. Built for one decisive mid-game charge."

msgctxt "path.wullof.boleny.tagline"
msgid "Kevés, drága, megállíthatatlan roham"
msgstr "A few costly, unstoppable charges"

msgctxt "path.wullof.groomi.name"
msgid "Groomi-fészek"
msgstr "Groomi Nest"

msgctxt "path.wullof.groomi.desc"
msgid "Piros szörnymadarak: a Groomik öléskor gyógyulnak és gyorsabbak, a Groomi-anya fiókákat keltet. A köpésük (sav, tűz vagy fagy) egyszer, végleg választható. Munkásvadászat, térképuralom."
msgstr "Red monster birds: Groomis heal on kills and run faster, the Groomi Mother hatches chicks. Their spit (acid, fire or frost) can be chosen once, permanently. Worker hunting, map control."

msgctxt "path.wullof.groomi.tagline"
msgid "Gyors portyázás, vadászat a gyengékre"
msgstr "Fast raids, hunting the weak"

msgctxt "path.wullof.osok.name"
msgid "Ősök útja"
msgstr "Way of the Ancestors"

msgctxt "path.wullof.osok.desc"
msgid "Totemkertet emelsz: a tornyok erősebbek és messzebbre látnak, az épületek szívósabbak. Totemfaragók és Álomjárók támogatják a termeszvár-óriásokat. Védekező, területfoglaló játék."
msgstr "You raise a Totem Garden: towers hit harder and see farther, buildings are tougher. Totem Carvers and Dreamwalkers support the Termite-mound Giants. A defensive, territorial game."

msgctxt "path.wullof.osok.tagline"
msgid "Totemlánc, lassú és biztos előrenyomulás"
msgstr "Totem chain, slow and sure advance"

msgctxt "ability.pajzsfal.name"
msgid "Pajzsfal"
msgstr "Shield Wall"

msgctxt "ability.pajzsfal.desc"
msgid "Összezárt pajzsok: -60% távolsági sebzés, +2 páncél, de fele sebesség."
msgstr "Locked shields: -60% ranged damage, +2 armour, but half speed."

msgctxt "ability.napvihar.name"
msgid "Napvihar"
msgstr "Sun Storm"

msgctxt "ability.napvihar.desc"
msgid "Izzó meteorpor-zápor: 4 mp alatt 88 sebzés minden ellenségnek a területen."
msgstr "A rain of glowing meteor dust: 88 damage over 4 s to every enemy in the area."

msgctxt "ability.oruletkod.name"
msgid "Őrület köde"
msgstr "Mist of Madness"

msgctxt "ability.oruletkod.desc"
msgid "Elmét bomlasztó spórafelhő: 50% lassítás és folyamatos sebzés 6 mp-ig."
msgstr "A mind-rending spore cloud: 50% slow and continuous damage for 6 s."

msgctxt "ability.gyogyitas.name"
msgid "Rúnás gyógyítás"
msgstr "Rune Healing"

msgctxt "ability.gyogyitas.desc"
msgid "Automatikusan gyógyítja a közeli sérült élő szövetségeseket."
msgstr "Automatically heals nearby wounded living allies."

msgctxt "ability.vagta.name"
msgid "Vágta"
msgstr "Gallop"

msgctxt "ability.vagta.desc"
msgid "A gyíkhátas 4 mp-ig 80%-kal gyorsabb."
msgstr "The lizard rider is 80% faster for 4 s."

msgctxt "ability.roham.name"
msgid "Roham"
msgstr "Charge"

msgctxt "ability.roham.desc"
msgid "4 mp-ig +70% sebesség és +30% sebzés."
msgstr "+70% speed and +30% damage for 4 s."

msgctxt "ability.holdgyogyitas.name"
msgid "Holdfény-gyógyítás"
msgstr "Moonlight Healing"

msgctxt "ability.holdgyogyitas.desc"
msgid "Automatikusan gyógyítja a közeli sérült élő szövetségeseket."
msgstr "Automatically heals nearby wounded living allies."

msgctxt "ability.szellemfarkasok.name"
msgid "Szellemfarkasok"
msgstr "Spirit Wolves"

msgctxt "ability.szellemfarkasok.desc"
msgid "Két szellem-dingót idéz 30 másodpercre."
msgstr "Summons two spirit dingoes for 30 seconds."

msgctxt "ability.gyokerkotes.name"
msgid "Gyökérkötés"
msgstr "Root Binding"

msgctxt "ability.gyokerkotes.desc"
msgid "Gyökerek fonják körbe az ellenséget: 4 mp-ig szinte mozdulni sem tud."
msgstr "Roots wrap around the enemy: for 4 s it can barely move."

msgctxt "ability.osszeolvadas.name"
msgid "Összeolvadás"
msgstr "Merge"

msgctxt "ability.osszeolvadas.desc"
msgid "Három közeli Pöfeteg egyetlen Óriáspöfeteggé olvad."
msgstr "Three nearby Puffballs merge into a single Giant Puffball."

msgctxt "ability.lelekidezes.name"
msgid "Lélekidézés"
msgstr "Soul Calling"

msgctxt "ability.lelekidezes.desc"
msgid "Egy közeli tetemből szellemlégióst (nagy tetemből szellemkolosszust) támaszt."
msgstr "Raises a ghost legionary (a ghost colossus from a large corpse) from a nearby corpse."

msgctxt "ability.ostrommod.name"
msgid "Ostrom-mód"
msgstr "Siege Mode"

msgctxt "ability.ostrommod.desc"
msgid "A Kolosszus letelepszik: nem mozog, de +3 lőtáv és +25% sebzés."
msgstr "The Colossus settles: it cannot move, but +3 range and +25% damage."

msgctxt "ability.h_tava_nyil.name"
msgid "Nyomkereső nyíl"
msgstr "Tracking Arrow"

msgctxt "ability.h_tava_nyil.desc"
msgid "Tava célzott lövése: nagy sebzés és lassítás egy ellenségen."
msgstr "Tava's aimed shot: high damage and a slow on one enemy."

msgctxt "ability.h_tava_utenek.name"
msgid "Útének"
msgstr "Road Song"

msgctxt "ability.h_tava_utenek.desc"
msgid "A közeli szövetségesek gyorsabban mozognak (és jobban védekeznek)."
msgstr "Nearby allies move faster (and defend better)."

msgctxt "ability.h_tava_farkasok.name"
msgid "Szellemfarkasok"
msgstr "Spirit Wolves"

msgctxt "ability.h_tava_farkasok.desc"
msgid "Szellem-dingókat idéz."
msgstr "Summons spirit dingoes."

msgctxt "ability.h_tava_madar.name"
msgid "A Hét Út hívása"
msgstr "Call of the Seven Roads"

msgctxt "ability.h_tava_madar.desc"
msgid "Végső: két viharkakadu érkezik 45 másodpercre."
msgstr "Ultimate: two Storm Cockatoos arrive for 45 seconds."

msgctxt "ability.h_ragna_pajzsfal.name"
msgid "Pajzsfal"
msgstr "Shield Wall"

msgctxt "ability.h_ragna_pajzsfal.desc"
msgid "A pajzs először a mellette állót védi: kevesebb távolsági sebzés, több páncél."
msgstr "The shield protects the one beside her first: less ranged damage, more armour."

msgctxt "ability.h_ragna_esku.name"
msgid "Az eskü súlya"
msgstr "Weight of the Oath"

msgctxt "ability.h_ragna_esku.desc"
msgid "A közeli szövetségesek páncélja nő."
msgstr "Nearby allies gain armour."

msgctxt "ability.h_ragna_roham.name"
msgid "Pajzsroham"
msgstr "Shield Charge"

msgctxt "ability.h_ragna_roham.desc"
msgid "Ragna nekiront egy ellenségnek: sebzi és rövid időre megbénítja."
msgstr "Ragna rushes an enemy: damages it and stuns it briefly."

msgctxt "ability.h_ragna_hosszutel.name"
msgid "Hosszú tél"
msgstr "Long Winter"

msgctxt "ability.h_ragna_hosszutel.desc"
msgid "Végső képesség: fagyos vihar, amely lassít és sebez."
msgstr "Ultimate: a freezing storm that slows and damages."

msgctxt "ability.h_szelai_napvihar.name"
msgid "Napvihar"
msgstr "Sun Storm"

msgctxt "ability.h_szelai_napvihar.desc"
msgid "Izzó meteorpor-zápor."
msgstr "A rain of glowing meteor dust."

msgctxt "ability.h_szelai_rezonancia.name"
msgid "Rezonancia"
msgstr "Resonance"

msgctxt "ability.h_szelai_rezonancia.desc"
msgid "A közeli szövetségesek sebzése nő."
msgstr "Nearby allies deal more damage."

msgctxt "ability.h_szelai_levalasztas.name"
msgid "Leválasztás"
msgstr "Severance"

msgctxt "ability.h_szelai_levalasztas.desc"
msgid "Rezonanciacsapás, amely egy célpontot kiszakít a hálózatából."
msgstr "A resonance strike that tears a target out of its network."

msgctxt "ability.h_szelai_csillagorok.name"
msgid "A Kilenc Lépcső őrei"
msgstr "Guardians of the Nine Steps"

msgctxt "ability.h_szelai_csillagorok.desc"
msgid "Végső képesség: négy tollas harcos-szellem."
msgstr "Ultimate: four feathered warrior spirits."

msgctxt "ability.h_mor_gyogyspora.name"
msgid "Gyógyspóra"
msgstr "Healing Spore"

msgctxt "ability.h_mor_gyogyspora.desc"
msgid "Automatikusan gyógyítja a közeli sérült élő szövetségeseket."
msgstr "Automatically heals nearby wounded living allies."

msgctxt "ability.h_mor_gyokerkotes.name"
msgid "Gyökérkötés"
msgstr "Root Binding"

msgctxt "ability.h_mor_gyokerkotes.desc"
msgid "Gyökerek fonják körbe az ellenséget."
msgstr "Roots wrap around the enemy."

msgctxt "ability.h_mor_emlekkert.name"
msgid "Emlékkert"
msgstr "Memory Garden"

msgctxt "ability.h_mor_emlekkert.desc"
msgid "A közeli szövetségesek gyorsabban regenerálódnak."
msgstr "Nearby allies regenerate faster."

msgctxt "ability.h_mor_ebredes.name"
msgid "Az Emlékkert ébredése"
msgstr "Awakening of the Memory Garden"

msgctxt "ability.h_mor_ebredes.desc"
msgid "Végső képesség: két Óriáspöfeteg sarjad."
msgstr "Ultimate: two Giant Puffballs sprout."

msgctxt "ability.h_livia_lelek.name"
msgid "Lélekmentés"
msgstr "Soul Rescue"

msgctxt "ability.h_livia_lelek.desc"
msgid "Egy közeli tetemből szellemlégióst támaszt."
msgstr "Raises a ghost legionary from a nearby corpse."

msgctxt "ability.h_livia_horgony.name"
msgid "Horgonyjavítás"
msgstr "Anchor Repair"

msgctxt "ability.h_livia_horgony.desc"
msgid "Automatikusan javítja a közeli sérült gépeket."
msgstr "Automatically repairs nearby damaged machines."

msgctxt "ability.h_livia_legio.name"
msgid "A légió fegyelme"
msgstr "Discipline of the Legion"

msgctxt "ability.h_livia_legio.desc"
msgid "A közeli szövetségesek sebzése nő."
msgstr "Nearby allies deal more damage."

msgctxt "ability.h_livia_lelegzet.name"
msgid "Második lélegzet"
msgstr "Second Breath"

msgctxt "ability.h_livia_lelegzet.desc"
msgid "Végső képesség: a területen minden szövetséges gyógyul."
msgstr "Ultimate: every ally in the area is healed."

msgctxt "ability.h_keth_kod.name"
msgid "Őrület köde"
msgstr "Mist of Madness"

msgctxt "ability.h_keth_kod.desc"
msgid "Elmét bomlasztó spórafelhő."
msgstr "A mind-rending spore cloud."

msgctxt "ability.h_keth_korushang.name"
msgid "Kórus-hang"
msgstr "Choir Voice"

msgctxt "ability.h_keth_korushang.desc"
msgid "A közeli szövetségesek gyorsabbak és regenerálódnak."
msgstr "Nearby allies are faster and regenerate."

msgctxt "ability.h_keth_csap.name"
msgid "Csápcsapás"
msgstr "Tendril Lash"

msgctxt "ability.h_keth_csap.desc"
msgid "Savas csapás egy célpontra."
msgstr "An acid strike on one target."

msgctxt "ability.h_keth_sokasag.name"
msgid "A sokaság"
msgstr "The Multitude"

msgctxt "ability.h_keth_sokasag.desc"
msgid "Végső képesség: legfeljebb négy Karmos kel ki. Nem jár le az élettartamuk, és nem foglalnak létszámot. Keth egyszerre legfeljebb négy élő egységet idézhet."
msgstr "Ultimate: six Clawlings hatch."

msgctxt "ability.h_nera_toltes.name"
msgid "Gyorstöltés"
msgstr "Quick Charge"

msgctxt "ability.h_nera_toltes.desc"
msgid "Rövid ideig nagyobb sebzés."
msgstr "More damage for a short time."

msgctxt "ability.h_nera_loves.name"
msgid "Célzott lövés"
msgstr "Aimed Shot"

msgctxt "ability.h_nera_loves.desc"
msgid "Messzire hordó, erős lövés."
msgstr "A powerful long-range shot."

msgctxt "ability.h_nera_batorsag.name"
msgid "Bátorság"
msgstr "Courage"

msgctxt "ability.h_nera_batorsag.desc"
msgid "„Félek – és mégis megyek.” A közeli szövetségesek páncélja nő."
msgstr "„I am afraid – and I go anyway.” Nearby allies gain armour."

msgctxt "ability.h_nera_horgony.name"
msgid "Szabad horgony"
msgstr "Free Anchor"

msgctxt "ability.h_nera_horgony.desc"
msgid "Végső képesség: Nera felszabadult lelke 10 másodpercre félelmetes erővé válik."
msgstr "Ultimate: Nera's freed soul becomes a fearsome force for 10 seconds."

msgctxt "ability.h_itz_darda.name"
msgid "Obszidián-dárda"
msgstr "Obsidian Spear"

msgctxt "ability.h_itz_darda.desc"
msgid "Hajított obszidián-dárda: nagy sebzés, lassítás."
msgstr "A thrown obsidian spear: high damage, slow."

msgctxt "ability.h_itz_csapas.name"
msgid "Földrengető csapás"
msgstr "Earthshaker Strike"

msgctxt "ability.h_itz_csapas.desc"
msgid "A hadúr a földbe sújt: a körülötte állókat megsebzi és megbénítja."
msgstr "The warlord strikes the ground: damages and stuns those around him."

msgctxt "ability.h_itz_jelenlet.name"
msgid "A hadúr jelenléte"
msgstr "Presence of the Warlord"

msgctxt "ability.h_itz_jelenlet.desc"
msgid "A közeli szövetségesek páncélja és sebzése nő."
msgstr "Nearby allies gain armour and damage."

msgctxt "ability.h_itz_kukulkan.name"
msgid "Quetzlaru alakja"
msgstr "Form of Quetzlaru"

msgctxt "ability.h_itz_kukulkan.desc"
msgid "Végső képesség: a tollas kígyóisten ereje – kétszeres sebzés, +6 páncél."
msgstr "Ultimate: the power of the feathered serpent god – double damage, +6 armour."

msgctxt "ability.h_xochi_hullam.name"
msgid "Rezonanciahullám"
msgstr "Resonance Wave"

msgctxt "ability.h_xochi_hullam.desc"
msgid "Jádeszínű rezgés tépi szét a területet."
msgstr "A jade-coloured vibration tears the area apart."

msgctxt "ability.h_xochi_harmonia.name"
msgid "Harmónia"
msgstr "Harmony"

msgctxt "ability.h_xochi_harmonia.desc"
msgid "A közeli szövetségesek életereje és pajzsa gyorsabban töltődik."
msgstr "Nearby allies recover health and shields faster."

msgctxt "ability.h_xochi_jadeor.name"
msgid "Jádeőr"
msgstr "Jade Guardian"

msgctxt "ability.h_xochi_jadeor.desc"
msgid "Élő jádeszobrot ébreszt, amely a hívójáért harcol."
msgstr "Awakens a living jade statue that fights for its caller."

msgctxt "ability.h_xochi_napkorona.name"
msgid "Napkorona"
msgstr "Sun Crown"

msgctxt "ability.h_xochi_napkorona.desc"
msgid "Végső képesség: a területen minden szövetséges gyógyul."
msgstr "Ultimate: every ally in the area is healed."

msgctxt "ability.h_hja_szilank.name"
msgid "Jégszilánk"
msgstr "Ice Shard"

msgctxt "ability.h_hja_szilank.desc"
msgid "Fagyos szilánk: sebez és erősen lassít."
msgstr "A freezing shard: damages and slows heavily."

msgctxt "ability.h_hja_vihar.name"
msgid "Hóvihar"
msgstr "Blizzard"

msgctxt "ability.h_hja_vihar.desc"
msgid "Jeges vihar csap le a területre."
msgstr "An icy storm strikes the area."

msgctxt "ability.h_hja_bunda.name"
msgid "Téli bundák"
msgstr "Winter Pelts"

msgctxt "ability.h_hja_bunda.desc"
msgid "A közeli szövetségesek páncélja és regenerációja nő."
msgstr "Nearby allies gain armour and regeneration."

msgctxt "ability.h_hja_fagyott_ido.name"
msgid "Megfagyott idő"
msgstr "Frozen Time"

msgctxt "ability.h_hja_fagyott_ido.desc"
msgid "Végső képesség: minden közeli ellenség jégbe dermed."
msgstr "Ultimate: every nearby enemy freezes into ice."

msgctxt "ability.h_bja_medve.name"
msgid "Kardfogú hívása"
msgstr "Call of the Sabretooth"

msgctxt "ability.h_bja_medve.desc"
msgid "Kardfogú tigrist hív a hegyekből."
msgstr "Calls a sabretooth tiger from the mountains."

msgctxt "ability.h_bja_falka.name"
msgid "A falka ereje"
msgstr "Strength of the Pack"

msgctxt "ability.h_bja_falka.desc"
msgid "A közeli szövetségesek (és vadak) sebzése nő."
msgstr "Nearby allies (and beasts) deal more damage."

msgctxt "ability.h_bja_szigony.name"
msgid "Vadászszigony"
msgstr "Hunting Harpoon"

msgctxt "ability.h_bja_szigony.desc"
msgid "Szigonyt vet egy ellenségbe: sebzi és rövid időre megbénítja."
msgstr "Hurls a harpoon into an enemy: damages it and stuns it briefly."

msgctxt "ability.h_bja_mamutcsorda.name"
msgid "Mamutcsorda"
msgstr "Mammoth Herd"

msgctxt "ability.h_bja_mamutcsorda.desc"
msgid "Végső képesség: két harci mamut csatlakozik 40 másodpercre."
msgstr "Ultimate: two war mammoths join for 40 seconds."

msgctxt "ability.h_vor_sugar.name"
msgid "Savsugár"
msgstr "Acid Beam"

msgctxt "ability.h_vor_sugar.desc"
msgid "Maró savsugár."
msgstr "A corrosive beam of acid."

msgctxt "ability.h_vor_pancel.name"
msgid "Mutáns páncél"
msgstr "Mutant Armour"

msgctxt "ability.h_vor_pancel.desc"
msgid "Kitinlemezek nőnek a mester testén."
msgstr "Chitin plates grow on the master's body."

msgctxt "ability.h_vor_larvak.name"
msgid "Lárvahullám"
msgstr "Larva Wave"

msgctxt "ability.h_vor_larvak.desc"
msgid "Karmosokat költ ki. Nem jár le az élettartamuk, és nem foglalnak létszámot. Vor egyszerre legfeljebb négy élő egységet idézhet."
msgstr "Hatches Clawlings from his own body."

msgctxt "ability.h_vor_robbanas.name"
msgid "Kitinrobbanás"
msgstr "Chitin Burst"

msgctxt "ability.h_vor_robbanas.desc"
msgid "Végső képesség: kitinszilánkok repesznek szét a mester körül."
msgstr "Ultimate: chitin shards burst out around the master."

msgctxt "ability.h_ssa_felho.name"
msgid "Spórafelhő"
msgstr "Spore Cloud"

msgctxt "ability.h_ssa_felho.desc"
msgid "Fojtó spórafelhő."
msgstr "A choking spore cloud."

msgctxt "ability.h_ssa_rajtudat.name"
msgid "Rajtudat"
msgstr "Swarm Mind"

msgctxt "ability.h_ssa_rajtudat.desc"
msgid "A raj egy akarattal mozog: gyorsabb és erősebb."
msgstr "The swarm moves with one will: faster and stronger."

msgctxt "ability.h_ssa_oltes.name"
msgid "Hús-öltés"
msgstr "Flesh Stitch"

msgctxt "ability.h_ssa_oltes.desc"
msgid "Automatikusan összefoltozza a közeli sérült élő szövetségeseket."
msgstr "Automatically stitches up nearby wounded living allies."

msgctxt "ability.h_ssa_remszarnyak.name"
msgid "Rémszárnyak"
msgstr "Dread Wings"

msgctxt "ability.h_ssa_remszarnyak.desc"
msgid "Végső képesség: legfeljebb négy Szárnyas rém érkezik. Nem jár le az élettartamuk, és nem foglalnak létszámot. Ss’arha egyszerre legfeljebb négy élő egységet idézhet."
msgstr "Ultimate: four winged dreads arrive."

msgctxt "ability.h_var_holdfeny.name"
msgid "Holdfény"
msgstr "Moonlight"

msgctxt "ability.h_var_holdfeny.desc"
msgid "Automatikusan gyógyítja a közeli sérült szövetségeseket."
msgstr "Automatically heals nearby wounded allies."

msgctxt "ability.h_var_kod.name"
msgid "Ősök köde"
msgstr "Mist of the Ancestors"

msgctxt "ability.h_var_kod.desc"
msgid "Az ősök szellemei ködként fonják körül az ellenséget."
msgstr "The spirits of the ancestors wrap around the enemy like mist."

msgctxt "ability.h_var_falka.name"
msgid "Szellemfalka"
msgstr "Spirit Pack"

msgctxt "ability.h_var_falka.desc"
msgid "Szellem-dingók falkáját hívja."
msgstr "Calls a pack of spirit dingoes."

msgctxt "ability.h_var_telihold.name"
msgid "Telihold"
msgstr "Full Moon"

msgctxt "ability.h_var_telihold.desc"
msgid "Végső képesség: telihold-fény gyógyít a területen."
msgstr "Ultimate: full-moon light heals the area."

msgctxt "ability.h_kur_taposas.name"
msgid "Bölénytaposás"
msgstr "Bison Stomp"

msgctxt "ability.h_kur_taposas.desc"
msgid "A harci bölény a földbe dobbant: sebez és megbénít."
msgstr "The war bison stamps the ground: damages and stuns."

msgctxt "ability.h_kur_uvoltes.name"
msgid "Harci üvöltés"
msgstr "War Howl"

msgctxt "ability.h_kur_uvoltes.desc"
msgid "A közeli szövetségesek sebzése nő."
msgstr "Nearby allies deal more damage."

msgctxt "ability.h_kur_verfalka.name"
msgid "Vérfalka"
msgstr "Blood Pack"

msgctxt "ability.h_kur_verfalka.desc"
msgid "Vadászláz: rövid ideig gyorsabb és erősebb."
msgstr "Hunting frenzy: faster and stronger for a short time."

msgctxt "ability.h_kur_het_ut.name"
msgid "A Hét Út harcosai"
msgstr "Warriors of the Seven Roads"

msgctxt "ability.h_kur_het_ut.desc"
msgid "Végső képesség: öt lándzsás harcos érkezik a Hét Útról."
msgstr "Ultimate: five spear warriors arrive from the Seven Roads."

msgctxt "ability.h_gya_halo.name"
msgid "Gyökérháló"
msgstr "Root Web"

msgctxt "ability.h_gya_halo.desc"
msgid "Gyökerek fonják gúzsba az ellenséget."
msgstr "Roots bind the enemy."

msgctxt "ability.h_gya_melygyoker.name"
msgid "Mélygyökér"
msgstr "Deep Root"

msgctxt "ability.h_gya_melygyoker.desc"
msgid "Gyökeret ereszt: lassú, de szinte elpusztíthatatlan."
msgstr "Puts down roots: slow, but almost indestructible."

msgctxt "ability.h_gya_talaj.name"
msgid "Tápláló talaj"
msgstr "Nourishing Soil"

msgctxt "ability.h_gya_talaj.desc"
msgid "A közeli szövetségesek regenerációja és páncélja nő."
msgstr "Nearby allies gain regeneration and armour."

msgctxt "ability.h_gya_rengés.name"
msgid "Gyökérrengés"
msgstr "Root Quake"

msgctxt "ability.h_gya_rengés.desc"
msgid "Végső képesség: a föld alól feltörő gyökerek mindenkit megbénítanak."
msgstr "Ultimate: roots bursting from below stun everyone."

msgctxt "ability.h_spo_tuske.name"
msgid "Bomlasztó tüske"
msgstr "Decaying Spine"

msgctxt "ability.h_spo_tuske.desc"
msgid "Rothasztó spóratüske."
msgstr "A rotting spore spine."

msgctxt "ability.h_spo_rothadas.name"
msgid "Rothadás"
msgstr "Rot"

msgctxt "ability.h_spo_rothadas.desc"
msgid "Minden elrothad a területen."
msgstr "Everything rots in the area."

msgctxt "ability.h_spo_kopeny.name"
msgid "Spóraköpeny"
msgstr "Spore Cloak"

msgctxt "ability.h_spo_kopeny.desc"
msgid "Spórafelhőbe burkolózik: gyorsabb, és a lövések elvétik."
msgstr "Wraps itself in a spore cloud: faster, and shots miss."

msgctxt "ability.h_spo_raj.name"
msgid "Pöfeteg-raj"
msgstr "Puffball Swarm"

msgctxt "ability.h_spo_raj.desc"
msgid "Végső képesség: hat pöfeteg sarjad – robbanó spórazsákok."
msgstr "Ultimate: six puffballs sprout – exploding spore sacs."

msgctxt "ability.h_cas_roham.name"
msgid "Légió-roham"
msgstr "Legion Charge"

msgctxt "ability.h_cas_roham.desc"
msgid "A legátus gépteste előrelendül, és szétszórja az ellenséget."
msgstr "The legate's machine body surges forward and scatters the enemy."

msgctxt "ability.h_cas_fegyelem.name"
msgid "Vasfegyelem"
msgstr "Iron Discipline"

msgctxt "ability.h_cas_fegyelem.desc"
msgid "A közeli szövetségesek páncélja nő."
msgstr "Nearby allies gain armour."

msgctxt "ability.h_cas_legio.name"
msgid "Mechalégió"
msgstr "Mech Legion"

msgctxt "ability.h_cas_legio.desc"
msgid "Légiósokat rendel a frontra."
msgstr "Orders legionaries to the front."

msgctxt "ability.h_cas_harag.name"
msgid "Ordan haragja"
msgstr "Wrath of Ordan"

msgctxt "ability.h_cas_harag.desc"
msgid "Végső képesség: Ordan lelke tölti meg a legátus gépét."
msgstr "Ultimate: Ordan's soul fills the legate's machine."

msgctxt "ability.lelekhorgony_mentes.name"
msgid "Lélekhorgony mentése"
msgstr ""

msgctxt "ability.lelekhorgony_mentes.desc"
msgid "Jelölj ki egy saját Lélekhorgonyt, majd a lerakás helyét. A Légiós odamegy, felveszi és elszállítja. Egyszerre egy horgonyt vihet."
msgstr ""

msgctxt "ability.atvaltozas.name"
msgid "Mutáció itt"
msgstr "Mutation: Armoured Beetle"

msgctxt "ability.atvaltozas.desc"
msgid "A Karmos a kijelölt helyre megy, ott gubóba zárkózik, és Páncélbogárrá alakul."
msgstr "The Clawling shuts itself in a cocoon and turns into an armoured beetle."

msgctxt "ability.beszallas.name"
msgid "Helyőrség"
msgstr "Garrison"

msgctxt "ability.beszallas.desc"
msgid "A kijelölt egységek beszállnak a legközelebbi helyőrség-épületbe; ott védve vannak, és minden beszállt egység erősíti az épület lövéseit."
msgstr "The selected units enter the nearest garrison building; they are protected there, and every unit inside strengthens the building's shots."

msgctxt "ability.p_halozati_gyujtes.name"
msgid "Hálózati gyűjtés"
msgstr "Network Gathering"

msgctxt "ability.p_halozati_gyujtes.desc"
msgid "A terhét bármelyik hálózatba kötött épületbe leadhatja."
msgstr "Can drop its load at any building linked to the network."

msgctxt "ability.p_gepjavitas.name"
msgid "Gépjavítás és újratestesítés"
msgstr "Machine Repair and Re-embodiment"

msgctxt "ability.p_gepjavitas.desc"
msgid "Jobb klikk sérült gépre: javítás. A lélekhorgonyokat is újraépíti."
msgstr "Right-click a damaged machine: repair. Also rebuilds soul anchors."

msgctxt "ability.lelekhorgony.name"
msgid "Lélekhorgony"
msgstr "Soul Anchor"

msgctxt "ability.lelekhorgony.desc"
msgid "Ha a gép elpusztul, a lelke horgonyban marad 40 mp-ig – egy Fabrikátor újraépítheti."
msgstr "When the machine is destroyed, its soul stays in an anchor for 40 s – a Fabricator can rebuild it."

msgctxt "ability.osztodas2.name"
msgid "Osztódás (2 ölés)"
msgstr "Division (2 kills)"

msgctxt "ability.osztodas2.desc"
msgid "Minden két legyőzött ellenség után kettéosztódik (mintha megette volna őket)."
msgstr "After every two defeated enemies it divides in two (as if it had eaten them)."

msgctxt "ability.osztodas3.name"
msgid "Osztódás (3 ölés)"
msgstr "Division (3 kills)"

msgctxt "ability.osztodas3.desc"
msgid "Minden három legyőzött ellenség után kettéosztódik."
msgstr "After every three defeated enemies it divides in two."

msgctxt "ability.osztodas4.name"
msgid "Osztódás (4 ölés)"
msgstr "Division (4 kills)"

msgctxt "ability.osztodas4.desc"
msgid "Minden négy legyőzött ellenség után kettéosztódik."
msgstr "After every four defeated enemies it divides in two."

msgctxt "ability.erdei_rejtozes.name"
msgid "Erdei rejtőzés"
msgstr "Forest Stealth"

msgctxt "ability.erdei_rejtozes.desc"
msgid "Fák mellett, álló helyzetben láthatatlan (lesállás), amíg nem támad; a közeli ellenség észreveszi."
msgstr "Invisible next to trees until it attacks for 3 s (nearby enemies notice it)."

msgctxt "ability.korus_szem.name"
msgid "A Kórus szeme"
msgstr "Eye of the Choir"

msgctxt "ability.korus_szem.desc"
msgid "Felfedi a közeli rejtőzködő és beásott ellenségeket."
msgstr "Reveals nearby hidden and burrowed enemies."

msgctxt "ability.jadetest.name"
msgid "Jádetest"
msgstr "Jade Body"

msgctxt "ability.jadetest.desc"
msgid "A varázslatok csak fele sebzést okoznak neki."
msgstr "Spells deal only half damage to it."

msgctxt "ability.szellemtest.name"
msgid "Szellemtest"
msgstr "Spirit Body"

msgctxt "ability.szellemtest.desc"
msgid "Idézett lény; idővel szertefoszlik."
msgstr "A summoned being; fades away in time."

msgctxt "ability.gubo_p.name"
msgid "Gubó"
msgstr "Cocoon"

msgctxt "ability.gubo_p.desc"
msgid "Mutálódik; ha elpusztul, az átalakulás elvész."
msgstr "Mutating; if it is destroyed, the transformation is lost."

msgctxt "ability.taborkocsi.name"
msgid "Vándortábor"
msgstr "Wandering Camp"

msgctxt "ability.taborkocsi.desc"
msgid "Felszedett tábor – bárhol letelepíthető."
msgstr "A packed-up camp – can be pitched anywhere."

msgctxt "ability.kristalypancel.name"
msgid "Kristálypáncél"
msgstr "Crystal Armour"

msgctxt "ability.kristalypancel.desc"
msgid "Kemény kristályokkal benőtt páncél."
msgstr "Armour overgrown with hard crystals."

msgctxt "ability.falkavadasz.name"
msgid "Falkavadász"
msgstr "Pack Hunter"

msgctxt "ability.falkavadasz.desc"
msgid "Falkában vadászik."
msgstr "Hunts in a pack."

msgctxt "ability.runako_aura.name"
msgid "Rúnakő"
msgstr "Rune Stone"

msgctxt "ability.runako_aura.desc"
msgid "A közeli szövetségesek páncélja és gyógyulása nő."
msgstr "Nearby allies gain armour and regeneration."

msgctxt "ability.fenylepes.name"
msgid "Fénylépés"
msgstr "Light Step"

msgctxt "ability.fenylepes.desc"
msgid "Fénnyé válik, és a kijelölt pontra lép (7 mező)."
msgstr "Turns into light and steps to the chosen point (7 tiles)."

msgctxt "ability.fenylepes_munkas.name"
msgid "Fénylépés"
msgstr "Light Step"

msgctxt "ability.fenylepes_munkas.desc"
msgid "Menekülő teleport (5 mező)."
msgstr "An escape teleport (5 tiles)."

msgctxt "ability.jade_celzas.name"
msgid "Jáde-célzás"
msgstr "Jade Aim"

msgctxt "ability.jade_celzas.desc"
msgid "6 mp-ig +2 lőtáv és +20% sebzés."
msgstr "+2 range and +20% damage for 6 s."

msgctxt "ability.csillagdarda.name"
msgid "Csillagdárda"
msgstr "Star Spear"

msgctxt "ability.csillagdarda.desc"
msgid "Célzott, csillagérc-hegyű dárda: 45 sebzés és lassítás."
msgstr "An aimed, star-ore tipped spear: 45 damage and a slow."

msgctxt "ability.zuhanorepules.name"
msgid "Zuhanórepülés"
