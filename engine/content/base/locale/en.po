msgstr ""

msgctxt "unit.oon_dobos.name"
msgid "Taiko-dobos"
msgstr ""

msgctxt "unit.oon_dobos.desc"
msgid "Harci dobjával bátorítja az onikat, és ritmusával +50%-kal gyorsítja a közeli építkezést."
msgstr ""

msgctxt "unit.oon_kokutya.name"
msgid "Kőkutya-őr"
msgstr ""

msgctxt "unit.oon_kokutya.desc"
