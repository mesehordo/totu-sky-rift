msgstr "A living siege engine: spits corrosive chitin spines far, especially at buildings."

msgctxt "unit.cro_asoferegg.name"
msgid "Ásóféreg"
msgstr "Burrow Worm"

msgctxt "unit.cro_asoferegg.desc"
msgid "A föld alatt közlekedő féreg: beásva rejtőzik, és alulról támad."
msgstr "A worm that travels underground: hides burrowed and strikes from below."

msgctxt "building.cro_kaptar.name"
