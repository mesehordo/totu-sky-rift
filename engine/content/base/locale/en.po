msgstr "Tendril Horror"

msgctxt "unit.cro_csapos_horror.desc"
msgid "A mélység óriása. Csápjaival egyszerre több ellenfelet zúz."
msgstr "Giant of the deep. Its tendrils crush several foes at once."

msgctxt "unit.cro_hos_keth.name"
msgid "Keth"
msgstr "Keth"

msgctxt "unit.cro_hos_keth.desc"
msgid "Egy megszállt kethri város emlékőre; a Kórus parancsnoki csomópontja – de régi önmaga nem tűnt el."
msgstr "The memory-keeper of a possessed kethri city; a command node of the Choir – yet the old self has not vanished."

msgctxt "unit.cro_pancelbogar.name"
msgid "Páncélbogár"
msgstr "Armoured Beetle"

msgctxt "unit.cro_pancelbogar.desc"
msgid "Karmosból mutálódott, páncélos rohamállat. Csak mutációval jön létre."
msgstr "A Clawling mutated into an armoured assault beast. Only created by mutation."

msgctxt "unit.cro_guboj.name"
msgid "Gubó"
msgstr "Cocoon"

msgctxt "unit.cro_guboj.desc"
msgid "Mutálódó egység – sérülékeny, de páncélos burok."
msgstr "A mutating unit – a vulnerable but armoured shell."

msgctxt "unit.cro_szemhordozo.name"
msgid "Szemhordozó"
msgstr "Eye Bearer"

msgctxt "unit.cro_szemhordozo.desc"
