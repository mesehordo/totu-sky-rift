msgstr "The Master of Mutation: hatches larvae from his own body and grows chitin armour."

msgctxt "unit.cro_hos_ssarha.name"
msgid "Ssarha, a Raj Hangja"
msgstr "Ssarha, Voice of the Swarm"

msgctxt "unit.cro_hos_ssarha.desc"
msgid "A Kórus hangja: a rajt egy akaratba fogja, és összeölti a sebeket."
msgstr "The voice of the Choir: binds the swarm into one will and stitches its wounds."

msgctxt "unit.cro_robbanoatka.name"
