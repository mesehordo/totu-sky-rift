<?xml version="1.0" encoding="utf-8"?>
<!-- Csak ehhez a projekthez: a hivatalos nuget.org forrás (a felhasználói NuGet-beállítás érintetlen marad). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
